# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=snack_mall
DB_USER=root
DB_PASSWORD=666666

# 微信小程序配置（重要！）
# 获取方式：登录 https://mp.weixin.qq.com/ -> 开发 -> 开发管理 -> 开发设置
WX_APPID=wxdca249674206beb2
WX_SECRET=your_app_secret_here

# JWT配置
# JWT_SECRET 建议使用随机字符串，至少32位
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS配置
CORS_ORIGIN=*

# 日志配置
LOG_LEVEL=info
