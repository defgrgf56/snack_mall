/**app.wxss**/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

/* 容器 */
.container {
  padding: 20rpx;
}

/* 卡片 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 按钮 */
.btn-primary {
  background-color: #FF6B00;
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
}

.btn-secondary {
  background-color: #fff;
  color: #FF6B00;
  border: 2rpx solid #FF6B00;
  border-radius: 50rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
}

.btn-disabled {
  background-color: #ccc;
  color: #999;
  border-radius: 50rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
}

/* 文本 */
.text-primary {
  color: #FF6B00;
}

.text-secondary {
  color: #666;
}

.text-muted {
  color: #999;
}

.text-small {
  font-size: 24rpx;
}

.text-normal {
  font-size: 28rpx;
}

.text-large {
  font-size: 32rpx;
}

.text-bold {
  font-weight: bold;
}

/* 价格 */
.price {
  color: #FF6B00;
  font-weight: bold;
}

.price-symbol {
  font-size: 24rpx;
}

.price-integer {
  font-size: 36rpx;
}

.price-decimal {
  font-size: 28rpx;
}

.price-original {
  color: #999;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 10rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  margin-right: 8rpx;
}

.tag-hot {
  background-color: #FF6B00;
  color: #fff;
}

.tag-new {
  background-color: #52C41A;
  color: #fff;
}

.tag-discount {
  background-color: #FF4D4F;
  color: #fff;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 20rpx 0;
}

/* 布局 */
.flex {
  display: flex;
}

.flex-row {
  flex-direction: row;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  align-items: center;
  justify-content: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* 间距 */
.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.ml-10 {
  margin-left: 10rpx;
}

.ml-20 {
  margin-left: 20rpx;
}

.mr-10 {
  margin-right: 10rpx;
}

.mr-20 {
  margin-right: 20rpx;
}

.p-10 {
  padding: 10rpx;
}

.p-20 {
  padding: 20rpx;
}
