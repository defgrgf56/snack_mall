/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50px;
  background: white;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -1rpx 6rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
}

/* 小屏幕适配 */
@media screen and (max-width: 640rpx) {
  .tab-bar {
    height: 48px;
  }
}

/* 大屏幕适配 */
@media screen and (min-width: 1024rpx) {
  .tab-bar {
    height: 54px;
  }
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 30rpx;
  padding-bottom: 2rpx;
}

/* 小屏幕适配 */
@media screen and (max-width: 640rpx) {
  .tab-bar-item {
    padding-top: 26rpx;
    padding-bottom: 2rpx;
  }
}

/* 大屏幕适配 */
@media screen and (min-width: 1024rpx) {
  .tab-bar-item {
    padding-top: 34rpx;
    padding-bottom: 4rpx;
  }
}

/* 图标包裹容器 */
.tab-icon-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 6rpx;
  filter: grayscale(100%);
  opacity: 0.6;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 小屏幕图标适配 */
@media screen and (max-width: 640rpx) {
  .tab-icon {
    font-size: 44rpx;
    margin-bottom: 5rpx;
  }
}

/* 大屏幕图标适配 */
@media screen and (min-width: 1024rpx) {
  .tab-icon {
    font-size: 52rpx;
    margin-bottom: 7rpx;
  }
}

.tab-icon.active {
  filter: grayscale(0%);
  opacity: 1;
  transform: scale(1.1);
}

.tab-text {
  font-size: 20rpx;
  color: #999999;
  transition: color 0.3s;
}

/* 小屏幕文字适配 */
@media screen and (max-width: 640rpx) {
  .tab-text {
    font-size: 18rpx;
  }
}

/* 大屏幕文字适配 */
@media screen and (min-width: 1024rpx) {
  .tab-text {
    font-size: 22rpx;
  }
}

.tab-text.active {
  color: #FF6B00;
  font-weight: bold;
}

/* 购物车徽章 */
.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.4);
  z-index: 10;
}

@media screen and (max-width: 640rpx) {
  .cart-badge {
    top: -6rpx;
    right: -14rpx;
    min-width: 28rpx;
    height: 28rpx;
    border-radius: 14rpx;
    padding: 0 6rpx;
  }
}

@media screen and (min-width: 1024rpx) {
  .cart-badge {
    top: -10rpx;
    right: -18rpx;
    min-width: 36rpx;
    height: 36rpx;
    border-radius: 18rpx;
    padding: 0 10rpx;
  }
}

.badge-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
  transform: scale(0.9);
}

@media screen and (max-width: 640rpx) {
  .badge-text {
    font-size: 18rpx;
  }
}

@media screen and (min-width: 1024rpx) {
  .badge-text {
    font-size: 22rpx;
  }
}
