<!--custom-tab-bar/index.wxml-->
<view class="tab-bar">
  <view 
    wx:for="{{list}}" 
    wx:key="index" 
    class="tab-bar-item" 
    data-path="{{item.pagePath}}" 
    data-index="{{index}}" 
    bindtap="switchTab"
  >
    <view class="tab-icon-wrapper">
      <text class="tab-icon {{selected === index ? 'active' : ''}}">{{item.iconText}}</text>
      <!-- 购物车徽章 -->
      <view class="cart-badge" wx:if="{{item.showBadge && cartCount > 0}}">
        <text class="badge-text">{{cartCount > 99 ? '99+' : cartCount}}</text>
      </view>
    </view>
    <text class="tab-text {{selected === index ? 'active' : ''}}">{{item.text}}</text>
  </view>
</view>
