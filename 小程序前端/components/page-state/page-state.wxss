/* components/page-state/page-state.wxss */

.page-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  padding: 60rpx 40rpx;
}

/* 加载中 */
.state-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #FF6B00;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.state-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-button {
  margin-top: 20rpx;
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #FF6B00;
  color: white;
  border-radius: 35rpx;
  font-size: 28rpx;
  border: none;
}

/* 错误状态 */
.state-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.error-icon {
  width: 200rpx;
  height: 200rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999;
}

.error-button {
  margin-top: 20rpx;
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #FF6B00;
  color: white;
  border-radius: 35rpx;
  font-size: 28rpx;
  border: none;
}