/* pages/review-list/review-list.wxss */
.review-list-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 评价统计 */
.stats-section {
  display: flex;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.stats-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 2rpx solid rgba(255, 255, 255, 0.3);
  padding-right: 40rpx;
}

.good-rate {
  font-size: 64rpx;
  font-weight: bold;
  line-height: 1;
  margin-bottom: 12rpx;
}

.good-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.stats-right {
  flex: 1;
  display: flex;
  justify-content: space-around;
  padding-left: 40rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1;
  margin-bottom: 12rpx;
}

.stats-label {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 筛选区域 */
.filter-section {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  gap: 20rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.filter-item.active {
  color: #fff;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  font-weight: bold;
}

/* 评价列表 */
.review-list {
  padding: 20rpx 0;
}

.review-item {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

/* 评价头部 */
.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.review-stars {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 24rpx;
  color: #ddd;
}

.star.active {
  color: #ffb400;
}

.review-date {
  font-size: 24rpx;
  color: #999;
}

/* 评价内容 */
.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 评价图片 */
.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.review-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

/* 商家回复 */
.reply-section {
  background: #f8f8f8;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.reply-label {
  font-size: 24rpx;
  color: #ff6b00;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.reply-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 点赞 */
.review-actions {
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 50rpx;
  font-size: 24rpx;
  color: #666;
}

.action-btn:active {
  opacity: 0.7;
}

.like-icon {
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-state,
.loadmore-state,
.nomore-state {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #999;
}
