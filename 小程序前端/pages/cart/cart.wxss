/* pages/cart/cart.wxss */
.cart-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999;
}

/* 购物车列表 */
.cart-list {
  flex: 1;
  padding: 20rpx 0;
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); /* 结算栏(100rpx) + TabBar(100rpx) + 额外空间(40rpx) */
  overflow-y: auto;
  -webkit-overflow-scrolling: touch; /* iOS滑动优化 */
}

/* 响应式调整 - 小屏 */
@media screen and (max-width: 640rpx) {
  .cart-list {
    padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  }
}

/* 响应式调整 - 大屏 */
@media screen and (min-width: 1024rpx) {
  .cart-list {
    padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
  }
}

.cart-item {
  background: white;
  margin-bottom: 20rpx;
  padding: 25rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

@media screen and (max-width: 640rpx) {
  .cart-item {
    padding: 20rpx;
    gap: 15rpx;
  }
}

/* 选择框 */
.item-checkbox {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
}

.checkbox.checked {
  background: #ff6b00;
  border-color: #ff6b00;
}

/* 商品图片 */
.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

@media screen and (max-width: 640rpx) {
  .item-image {
    width: 140rpx;
    height: 140rpx;
  }
}

@media screen and (min-width: 768rpx) {
  .item-image {
    width: 180rpx;
    height: 180rpx;
  }
}

/* 商品信息 */
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 32rpx;
  color: #ff6b00;
  font-weight: bold;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.quantity-btn {
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}

.quantity-btn.disabled {
  color: #ccc;
  border-color: #eee;
}

.quantity-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

/* 删除按钮 */
.item-delete {
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 垃圾桶图标 */
.delete-icon {
  width: 32rpx;
  height: 36rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.5;
}

/* 垃圾桶盖子 */
.delete-icon-lid {
  width: 32rpx;
  height: 4rpx;
  background: #999;
  border-radius: 2rpx;
  position: relative;
}

.delete-icon-lid::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 4rpx;
  background: #999;
  border-radius: 2rpx;
}

/* 垃圾桶身体 */
.delete-icon-body {
  width: 26rpx;
  height: 28rpx;
  border: 2rpx solid #999;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  position: relative;
  margin-top: 2rpx;
}

.delete-icon-body::before,
.delete-icon-body::after {
  content: '';
  position: absolute;
  width: 2rpx;
  height: 16rpx;
  background: #999;
  top: 4rpx;
}

.delete-icon-body::before {
  left: 6rpx;
}

.delete-icon-body::after {
  right: 6rpx;
}

/* 响应式调整 */
@media screen and (max-width: 640rpx) {
  .delete-icon {
    width: 28rpx;
    height: 32rpx;
  }
  
  .delete-icon-lid {
    width: 28rpx;
  }
  
  .delete-icon-body {
    width: 24rpx;
    height: 24rpx;
  }
}

@media screen and (min-width: 1024rpx) {
  .delete-icon {
    width: 36rpx;
    height: 40rpx;
  }
  
  .delete-icon-lid {
    width: 36rpx;
  }
  
  .delete-icon-body {
    width: 30rpx;
    height: 32rpx;
  }
}

/* 空购物车 */
.empty-cart {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 100rpx);
  padding: 0;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shopping-btn {
  width: 300rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #ff6b00 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.go-shopping-btn::after {
  border: none;
}

/* 底部结算栏 */
.cart-footer {
  background: white;
  padding: 20rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: fixed;
  bottom: 100rpx; /* 在TabBar上方 */
  left: 0;
  right: 0;
  z-index: 100;
  min-height: 80rpx;
}

/* 响应式调整 - 小屏 */
@media screen and (max-width: 640rpx) {
  .cart-footer {
    padding: 15rpx 15rpx;
    padding-bottom: calc(15rpx + env(safe-area-inset-bottom));
    min-height: 70rpx;
  }
}

/* 响应式调整 - 大屏 */
@media screen and (min-width: 1024rpx) {
  .cart-footer {
    padding: 25rpx 30rpx;
    padding-bottom: calc(25rpx + env(safe-area-inset-bottom));
    min-height: 90rpx;
  }
}

.footer-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding-right: 20rpx;
}

.select-text {
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
}

.total-info {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex: 1;
  justify-content: flex-end;
  padding-right: 20rpx;
  min-width: 0;
}

.total-label {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
  white-space: nowrap;
}

.total-price {
  font-size: 32rpx;
  color: #ff6b00;
  font-weight: bold;
  flex-shrink: 0;
  white-space: nowrap;
}

.checkout-btn {
  min-width: 160rpx;
  max-width: 200rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #ff6b00 100%);
  color: white;
  border-radius: 35rpx;
  font-size: 28rpx;
  border: none;
  line-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.checkout-btn::after {
  border: none;
}

.checkout-btn.disabled {
  background: #ccc;
}
