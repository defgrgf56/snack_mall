<!--pages/cart/cart.wxml-->
<view class="cart-container">
  <!-- 购物车列表 -->
  <scroll-view class="cart-list" scroll-y wx:if="{{cartItems.length > 0}}">
    <view 
      class="cart-item"
      wx:for="{{cartItems}}"
      wx:key="id"
    >
      <!-- 选择框 -->
      <view class="item-checkbox" bindtap="onSelectItem" data-id="{{item.id}}">
        <image 
          class="checkbox-icon" 
          src="{{item.selected ? '/images/checkbox-selected.png' : '/images/checkbox.png'}}" 
          mode="aspectFit"
        />
      </view>

      <!-- 商品信息 -->
      <image class="item-image" src="{{item.product.image}}" mode="aspectFill" />
      
      <view class="item-info">
        <text class="item-name">{{item.product.name}}</text>
        <text class="item-spec" wx:if="{{item.product.spec}}">{{item.product.spec}}</text>
        
        <view class="item-footer">
          <text class="item-price">¥{{item.product.price}}</text>
          
          <!-- 数量选择器 -->
          <view class="quantity-control">
            <view 
              class="quantity-btn {{item.quantity <= 1 ? 'disabled' : ''}}"
              bindtap="onDecreaseQuantity"
              data-id="{{item.id}}"
            >
              <text>-</text>
            </view>
            <input 
              class="quantity-input" 
              type="number" 
              value="{{item.quantity}}"
              disabled
            />
            <view 
              class="quantity-btn"
              bindtap="onIncreaseQuantity"
              data-id="{{item.id}}"
            >
              <text>+</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 删除按钮 -->
      <view class="item-delete" bindtap="onDeleteItem" data-id="{{item.id}}">
        <image class="delete-icon" src="/images/delete.png" mode="aspectFit" />
      </view>
    </view>
  </scroll-view>

  <!-- 空购物车 -->
  <view class="empty-cart" wx:else>
    <image class="empty-image" src="/images/empty-cart.png" mode="aspectFit" />
    <text class="empty-text">购物车还是空的</text>
    <button class="go-shopping-btn" bindtap="onGoShopping">去逛逛</button>
  </view>

  <!-- 底部结算栏 -->
  <view class="cart-footer" wx:if="{{cartItems.length > 0}}">
    <view class="footer-left">
      <view class="select-all" bindtap="onSelectAll">
        <image 
          class="checkbox-icon" 
          src="{{allSelected ? '/images/checkbox-selected.png' : '/images/checkbox.png'}}" 
          mode="aspectFit"
        />
        <text>全选</text>
      </view>
      
      <view class="total-info">
        <text class="total-label">合计：</text>
        <text class="total-price">¥{{totalPrice}}</text>
      </view>
    </view>

    <button 
      class="checkout-btn {{selectedCount > 0 ? '' : 'disabled'}}"
      bindtap="onCheckout"
    >
      结算({{selectedCount}})
    </button>
  </view>
</view>
