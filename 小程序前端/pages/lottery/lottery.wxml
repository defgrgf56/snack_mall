<!--pages/lottery/lottery.wxml-->
<view class="lottery-page">
  <!-- 顶部信息 -->
  <view class="header">
    <view class="points-info">
      <text class="label">我的积分</text>
      <text class="value">{{userPoints}}</text>
    </view>
    <view class="action-btns">
      <view class="btn-records" bindtap="onShowRecords">中奖记录</view>
      <view class="btn-rules" bindtap="onShowRules">抽奖规则</view>
    </view>
  </view>

  <!-- 活动选择 -->
  <view class="activity-selector" wx:if="{{activities.length > 1}}">
    <picker 
      mode="selector" 
      range="{{activities}}" 
      range-key="name"
      bindchange="onActivityChange"
    >
      <view class="picker-display">
        <text>{{currentActivity.name}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 当前活动信息 -->
  <view class="activity-info" wx:if="{{currentActivity}}">
    <view class="activity-name">{{currentActivity.name}}</view>
    <view class="activity-cost">
      <text class="cost-num">{{currentActivity.points_cost}}</text>
      <text class="cost-unit">积分/次</text>
    </view>
  </view>

  <!-- 抽奖转盘 -->
  <view class="lottery-wheel" wx:if="{{prizes.length > 0}}">
    <!-- 转盘背景 -->
    <view class="wheel-bg">
      <!-- 奖品扇形区域 -->
      <view 
        class="prize-sector prize-{{index}}" 
        wx:for="{{prizes}}" 
        wx:key="id"
        style="transform: rotate({{item.startAngle}}deg)"
      >
        <view class="prize-content">
          <text class="prize-name">{{item.name}}</text>
          <text class="prize-probability">{{item.probability}}%</text>
        </view>
      </view>
      
      <!-- 旋转的转盘 -->
      <view 
        class="wheel-rotate {{isRotating ? 'rotating' : ''}}"
        style="transform: rotate({{rotateAngle}}deg); transition: {{isRotating ? 'transform 3s cubic-bezier(0.25, 0.1, 0.25, 1)' : 'none'}}"
      >
        <view 
          class="prize-item"
          wx:for="{{prizes}}" 
          wx:key="id"
          style="transform: rotate({{360 / prizes.length * index}}deg)"
        >
          <view class="prize-icon">🎁</view>
        </view>
      </view>
    </view>

    <!-- 抽奖按钮 -->
    <view class="lottery-btn {{isRotating ? 'rotating' : ''}}" bindtap="onStartLottery">
      <view class="btn-text">{{isRotating ? '抽奖中' : '开始抽奖'}}</view>
    </view>

    <!-- 指针 -->
    <view class="pointer"></view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{prizes.length === 0}}">
    <text class="empty-icon">🎰</text>
    <text class="empty-text">暂无抽奖活动</text>
  </view>

  <!-- 中奖结果弹窗 -->
  <view class="result-modal" wx:if="{{showResult}}" catchtap="onCloseResult">
    <view class="modal-content" catchtap="{{}}">
      <view class="modal-title">🎉 恭喜中奖</view>
      <view class="prize-result">
        <view class="prize-icon-large">🎁</view>
        <view class="prize-name">{{resultPrize.prize_name}}</view>
      </view>
      <view class="modal-tip">奖品将在3-5个工作日内发放</view>
      <view class="btn-confirm" bindtap="onCloseResult">确定</view>
    </view>
  </view>

  <!-- 中奖记录弹窗 -->
  <view class="records-modal" wx:if="{{showRecords}}" catchtap="onCloseRecords">
    <view class="modal-content" catchtap="{{}}">
      <view class="modal-header">
        <view class="modal-title">中奖记录</view>
        <view class="btn-close" bindtap="onCloseRecords">✕</view>
      </view>
      
      <view class="records-list" wx:if="{{records.length > 0}}">
        <view class="record-item" wx:for="{{records}}" wx:key="id">
          <view class="record-info">
            <view class="record-prize">{{item.prize_name}}</view>
            <view class="record-date">{{item.created_at}}</view>
          </view>
          <view class="record-status">
            {{item.status === 0 ? '待发放' : item.status === 1 ? '已发放' : '已完成'}}
          </view>
        </view>
      </view>
      
      <view class="empty-records" wx:if="{{records.length === 0}}">
        <text>暂无中奖记录</text>
      </view>
    </view>
  </view>
</view>
