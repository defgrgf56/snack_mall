/* pages/lottery/lottery.wxss */
page {
  background: linear-gradient(180deg, #FF6B00 0%, #FFA500 50%, #f5f5f5 50%, #f5f5f5 100%);
  min-height: 100vh;
}

.lottery-page {
  padding: 20rpx;
}

/* 顶部信息 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  color: white;
}

.points-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.points-info .label {
  font-size: 24rpx;
  opacity: 0.9;
}

.points-info .value {
  font-size: 48rpx;
  font-weight: bold;
}

.action-btns {
  display: flex;
  gap: 20rpx;
}

.btn-records,
.btn-rules {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 24rpx;
  backdrop-filter: blur(10rpx);
}

/* 活动选择器 */
.activity-selector {
  margin: 20rpx 0;
}

.picker-display {
  background: white;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  color: #999;
  font-size: 20rpx;
}

/* 活动信息 */
.activity-info {
  text-align: center;
  color: white;
  margin-bottom: 40rpx;
}

.activity-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.activity-cost {
  font-size: 24rpx;
  opacity: 0.9;
}

.cost-num {
  font-size: 32rpx;
  font-weight: bold;
  margin: 0 4rpx;
}

/* 抽奖转盘 */
.lottery-wheel {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin: 40rpx auto;
}

.wheel-bg {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: white;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
  position: relative;
}

/* 奖品扇形（背景色交替） */
.prize-sector {
  position: absolute;
  width: 50%;
  height: 50%;
  left: 50%;
  top: 50%;
  transform-origin: 0 0;
  overflow: hidden;
}

.prize-sector::before {
  content: '';
  position: absolute;
  width: 200%;
  height: 200%;
  background: var(--bg-color);
  transform-origin: 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.prize-sector:nth-child(odd)::before {
  --bg-color: #FFE5D0;
}

.prize-sector:nth-child(even)::before {
  --bg-color: #FFF5ED;
}

.prize-content {
  position: absolute;
  left: 30%;
  top: 20%;
  transform: rotate(45deg);
  text-align: center;
  width: 120rpx;
}

.prize-name {
  display: block;
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.prize-probability {
  display: block;
  font-size: 20rpx;
  color: #FF6B00;
}

/* 旋转层 */
.wheel-rotate {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  border-radius: 50%;
  will-change: transform;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.prize-item {
  position: absolute;
  width: 50%;
  height: 50%;
  left: 50%;
  top: 50%;
  transform-origin: 0 0;
}

.prize-icon {
  position: absolute;
  left: 40%;
  top: 15%;
  font-size: 48rpx;
}

/* 抽奖按钮 */
.lottery-btn {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C3A 100%);
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  border: 8rpx solid white;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.lottery-btn:active {
  transform: translate(-50%, -50%) scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.lottery-btn.rotating {
  pointer-events: none;
  opacity: 0.8;
}

.btn-text {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

/* 指针 */
.pointer {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 60rpx solid #FF6B00;
  left: 50%;
  top: -30rpx;
  transform: translateX(-50%);
  z-index: 20;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: white;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 中奖结果弹窗 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.result-modal .modal-content {
  width: 560rpx;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  animation: modalShow 0.3s ease;
}

@keyframes modalShow {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B00;
  margin-bottom: 40rpx;
}

.prize-result {
  margin-bottom: 40rpx;
}

.prize-icon-large {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.prize-result .prize-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.modal-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-confirm {
  padding: 24rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C3A 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* 中奖记录弹窗 */
.records-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.records-modal .modal-content {
  width: 100%;
  max-height: 80vh;
  background: white;
  border-radius: 24rpx 24rpx 0 0;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-header .modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.btn-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

.records-list {
  max-height: 60vh;
  overflow-y: auto;
  padding: 20rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.record-info {
  flex: 1;
}

.record-prize {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-status {
  font-size: 24rpx;
  color: #FF6B00;
  padding: 8rpx 16rpx;
  background: #FFF5F0;
  border-radius: 20rpx;
}

.empty-records {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
  font-size: 28rpx;
}
