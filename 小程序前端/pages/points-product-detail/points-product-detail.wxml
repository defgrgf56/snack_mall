<!--pages/points-product-detail/points-product-detail.wxml-->
<view class="product-detail" wx:if="{{product}}">
  <!-- 商品图片 -->
  <view class="product-image-wrapper" bindtap="onImageTap">
    <image class="product-image" src="{{product.image}}" mode="aspectFill" />
  </view>

  <!-- 商品信息 -->
  <view class="product-info">
    <view class="product-header">
      <view class="product-name">{{product.name}}</view>
      <view class="product-points">
        <text class="points-num">{{product.points}}</text>
        <text class="points-unit">积分</text>
      </view>
    </view>

    <view class="product-meta">
      <view class="meta-item">
        <text class="label">库存:</text>
        <text class="value">{{product.stock}}件</text>
      </view>
      <view class="meta-item" wx:if="{{product.limit_per_person > 0}}">
        <text class="label">限购:</text>
        <text class="value">{{product.limit_per_person}}件/人</text>
      </view>
      <view class="meta-item" wx:if="{{product.limit_per_person > 0}}">
        <text class="label">剩余可兑换:</text>
        <text class="value remaining">{{remainingLimit}}件</text>
      </view>
    </view>

    <view class="product-desc">
      <view class="desc-title">商品描述</view>
      <view class="desc-content">{{product.description || '暂无描述'}}</view>
    </view>
  </view>

  <!-- 我的积分 -->
  <view class="my-points">
    <view class="points-label">我的积分</view>
    <view class="points-value">{{userPoints}}</view>
    <view class="points-tip" bindtap="onRecordTap">兑换记录 ></view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="quantity-selector">
      <view class="quantity-label">数量</view>
      <view class="quantity-control">
        <view class="btn-minus {{quantity <= 1 ? 'disabled' : ''}}" bindtap="onQuantityMinus">-</view>
        <view class="quantity-value">{{quantity}}</view>
        <view class="btn-plus" bindtap="onQuantityPlus">+</view>
      </view>
    </view>
    <view class="exchange-info">
      <view class="total-points">
        <text class="label">共需</text>
        <text class="value">{{product.points * quantity}}</text>
        <text class="unit">积分</text>
      </view>
      <button 
        class="btn-exchange {{canExchange ? '' : 'disabled'}}" 
        bindtap="onExchange"
      >
        {{canExchange ? '立即兑换' : '无法兑换'}}
      </button>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{!product}}">
  <text>加载中...</text>
</view>
