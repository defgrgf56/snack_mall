/* pages/points-product-detail/points-product-detail.wxss */
page {
  background-color: #f5f5f5;
  padding-bottom: 180rpx;
}

/* 商品图片 */
.product-image-wrapper {
  width: 100%;
  height: 750rpx;
  background: white;
}

.product-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 商品信息 */
.product-info {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.product-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.product-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.5;
  margin-right: 20rpx;
}

.product-points {
  color: #FF6B00;
  font-weight: bold;
  white-space: nowrap;
}

.points-num {
  font-size: 40rpx;
}

.points-unit {
  font-size: 24rpx;
  margin-left: 4rpx;
}

/* 商品元信息 */
.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.meta-item {
  font-size: 26rpx;
}

.meta-item .label {
  color: #999;
  margin-right: 8rpx;
}

.meta-item .value {
  color: #333;
}

.meta-item .value.remaining {
  color: #FF6B00;
  font-weight: 500;
}

/* 商品描述 */
.product-desc {
  margin-top: 30rpx;
}

.desc-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* 我的积分 */
.my-points {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C3A 100%);
  margin-top: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  color: white;
}

.points-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.points-value {
  flex: 1;
  font-size: 48rpx;
  font-weight: bold;
  margin-left: 20rpx;
}

.points-tip {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.quantity-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quantity-label {
  font-size: 28rpx;
  color: #333;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-minus,
.btn-plus {
  width: 50rpx;
  height: 50rpx;
  border: 1rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}

.btn-minus.disabled {
  color: #ccc;
  border-color: #eee;
}

.quantity-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.exchange-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.total-points {
  font-size: 26rpx;
}

.total-points .label {
  color: #666;
}

.total-points .value {
  color: #FF6B00;
  font-size: 36rpx;
  font-weight: bold;
  margin: 0 4rpx;
}

.total-points .unit {
  color: #FF6B00;
  font-size: 24rpx;
}

.btn-exchange {
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C3A 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.2s ease;
}

.btn-exchange:active:not(.disabled) {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-exchange.disabled {
  background: #e0e0e0;
  color: #999;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
