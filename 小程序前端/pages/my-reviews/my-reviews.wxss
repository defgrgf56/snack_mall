/* pages/my-reviews/my-reviews.wxss */
.my-reviews-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  gap: 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.filter-tab.active {
  color: #fff;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  font-weight: bold;
}

/* 评价列表 */
.review-list {
  padding: 20rpx;
}

.review-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 商品行 */
.product-row {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.rating-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.star {
  font-size: 24rpx;
  color: #ddd;
}

.star.active {
  color: #ffb400;
}

.rating-text {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
}

/* 评价内容 */
.review-body {
  padding: 20rpx 0 0;
}

.review-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 评价图片 */
.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 16rpx;
}

.review-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
}

/* 商家回复 */
.reply-box {
  background: #fff8f0;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
}

.reply-label {
  font-size: 24rpx;
  color: #ff6b00;
  font-weight: bold;
}

.reply-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 底部信息 */
.review-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.review-time {
  font-size: 22rpx;
  color: #bbb;
}

.like-info {
  font-size: 22rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 50rpx;
  font-weight: bold;
}

.empty-btn:active {
  opacity: 0.85;
}

/* 加载状态 */
.loading-state,
.loadmore-state,
.nomore-state {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #999;
}