<!--pages/index/index.wxml-->
<view class="index-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input" bindtap="goSearch">
      <image class="search-icon" src="/images/icon-search.png"></image>
      <text class="search-placeholder">搜索零食</text>
    </view>
  </view>

  <!-- 轮播图 -->
  <view class="banner-container" wx:if="{{banners.length > 0}}">
    <swiper class="banner-swiper" indicator-dots autoplay interval="5000" circular>
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-item="{{item}}">
        <image class="banner-image" src="{{item.image}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
  </view>
  
  <!-- 调试信息 -->
  <view class="debug-info" wx:if="{{banners.length === 0}}" style="padding: 20rpx; background: #fff3cd; margin: 20rpx; border-radius: 8rpx;">
    <text style="color: #856404;">轮播图数据为空，请检查API返回</text>
  </view>

  <!-- 分类导航 -->
  <view class="category-nav">
    <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">
      <image class="category-icon" src="{{item.icon}}"></image>
      <text class="category-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 优惠券 -->
  <view class="coupon-section" wx:if="{{coupons.length > 0}}">
    <view class="section-header">
      <text class="section-title">限时优惠券</text>
      <view class="section-more" bindtap="goCoupon">
        <text>更多</text>
        <image class="icon-arrow" src="/images/icon-arrow-right.png"></image>
      </view>
    </view>
    <scroll-view class="coupon-list" scroll-x>
      <view class="coupon-item" wx:for="{{coupons}}" wx:key="id" bindtap="receiveCoupon" data-id="{{item.id}}">
        <view class="coupon-left">
          <view class="coupon-amount">
            <text class="coupon-symbol">¥</text>
            <text class="coupon-value">{{item.discount_value}}</text>
          </view>
          <text class="coupon-condition">满{{item.min_amount}}可用</text>
        </view>
        <view class="coupon-right">
          <text class="coupon-name">{{item.name}}</text>
          <text class="coupon-time">{{item.end_time}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 热门商品 -->
  <view class="product-section">
    <view class="section-header">
      <text class="section-title">🔥 热门推荐</text>
    </view>
    <view class="product-grid">
      <view class="product-item" wx:for="{{hotProducts}}" wx:key="id" bindtap="goProductDetail" data-id="{{item.id}}">
        <image class="product-image" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="product-tags">
          <text class="tag tag-hot" wx:if="{{item.is_hot}}">HOT</text>
          <text class="tag tag-new" wx:if="{{item.is_new}}">NEW</text>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-subtitle">{{item.subtitle}}</text>
          <view class="product-bottom">
            <view class="product-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
              <text class="price-original" wx:if="{{item.original_price}}">¥{{item.original_price}}</text>
            </view>
            <view class="product-sales">已售{{item.sales}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 新品上市 -->
  <view class="product-section">
    <view class="section-header">
      <text class="section-title">✨ 新品上市</text>
    </view>
    <view class="product-grid">
      <view class="product-item" wx:for="{{newProducts}}" wx:key="id" bindtap="goProductDetail" data-id="{{item.id}}">
        <image class="product-image" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="product-tags">
          <text class="tag tag-new">NEW</text>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-subtitle">{{item.subtitle}}</text>
          <view class="product-bottom">
            <view class="product-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
            </view>
            <view class="product-sales">已售{{item.sales}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && hotProducts.length === 0}}">
    <image class="empty-image" src="/images/empty.png"></image>
    <text class="empty-text">暂无商品</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
