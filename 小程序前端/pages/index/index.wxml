<!--pages/index/index.wxml-->
<view class="index-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-content" style="height: {{menuHeight}}px; top: {{menuTop}}px;">
      <!-- Logo区域 -->
      <view class="nav-logo-area">
        <view class="logo-circle">
          <text class="logo-text">阿宇</text>
        </view>
        <view class="nav-text-area">
          <text class="nav-title">阿宇商城</text>
          <text class="nav-slogan">🏪 品质生活，一站购齐</text>
        </view>
      </view>
      
      <!-- 右侧小Logo(自适应计算位置,不覆盖微信胶囊) -->
      <view class="nav-right-logo" style="right: {{logoRight}}px; height: {{menuHeight}}px;">
        <view class="right-logo-circle">
          <text class="right-logo-text">阿宇</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar" style="top: {{navBarHeight}}px;">
    <view class="search-input" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索零食</text>
    </view>
  </view>

  <!-- 轮播图 -->
  <view class="banner-container" wx:if="{{banners.length > 0}}" style="margin-top: {{navBarHeight + 80}}px;">
    <swiper class="banner-swiper" indicator-dots autoplay interval="5000" circular>
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-item="{{item}}">
        <image class="banner-image" src="{{item.image}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 优惠券领取中心 -->
  <view class="coupon-section" wx:if="{{coupons.length > 0}}">
    <view class="section-header">
      <text class="section-title">🎫 优惠券中心</text>
      <text class="section-more" bindtap="goMyCoupons">我的优惠券 ></text>
    </view>
    <scroll-view class="coupon-scroll" scroll-x>
      <view class="coupon-list">
        <view class="coupon-item" wx:for="{{coupons}}" wx:key="id">
          <view class="coupon-content">
            <view class="coupon-left">
              <view class="coupon-amount-box">
                <text class="coupon-symbol">¥</text>
                <text class="coupon-amount" wx:if="{{item.discount_type === 1}}">{{item.discount_value}}</text>
                <text class="coupon-amount" wx:if="{{item.discount_type === 2}}">{{item.discount_value}}</text>
                <text class="coupon-unit" wx:if="{{item.discount_type === 2}}">折</text>
              </view>
              <text class="coupon-condition">满{{item.min_amount}}元可用</text>
            </view>
            <view class="coupon-right">
              <text class="coupon-name">{{item.name}}</text>
              <text class="coupon-time">{{item.start_time}} - {{item.end_time}}</text>
              <view class="coupon-btn" bindtap="receiveCoupon" data-id="{{item.id}}">
                <text>立即领取</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 限时秒杀 -->
  <view class="seckill-section" wx:if="{{seckills.length > 0}}">
    <view class="section-header seckill-header">
      <view class="seckill-title-box">
        <text class="section-title seckill-title">⚡ 限时秒杀</text>
        <view class="seckill-countdown" wx:if="{{seckillCountdown > 0}}">
          <text class="countdown-label">距结束</text>
          <view class="countdown-time">
            <text class="time-unit">{{seckillHours}}</text>
            <text class="time-sep">:</text>
            <text class="time-unit">{{seckillMinutes}}</text>
            <text class="time-sep">:</text>
            <text class="time-unit">{{seckillSeconds}}</text>
          </view>
        </view>
      </view>
      <text class="section-more" bindtap="goSeckillList">更多 ></text>
    </view>
    <scroll-view class="seckill-scroll" scroll-x>
      <view class="seckill-list">
        <view class="seckill-item" wx:for="{{seckills}}" wx:key="id" bindtap="goProductDetail" data-id="{{item.product.id}}">
          <image class="seckill-image" src="{{item.product.cover}}" mode="aspectFill"></image>
          <view class="seckill-badge">限时</view>
          <view class="seckill-info">
            <text class="seckill-product-name">{{item.product.name}}</text>
            <view class="seckill-price-box">
              <view class="seckill-price">
                <text class="price-symbol">¥</text>
                <text class="price-value">{{item.seckill_price}}</text>
              </view>
              <text class="seckill-original-price">¥{{item.original_price}}</text>
            </view>
            <view class="seckill-progress">
              <view class="progress-bar">
                <view class="progress-fill" style="width: {{item.progress}}%"></view>
              </view>
              <text class="progress-text">已抢{{item.progress}}%</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 活动专区 -->
  <view class="activity-section" wx:if="{{activities.length > 0}}">
    <view class="section-header">
      <text class="section-title">🎉 活动专区</text>
    </view>
    <view class="activity-grid">
      <view class="activity-item" wx:for="{{activities}}" wx:key="id" bindtap="goActivityDetail" data-id="{{item.id}}">
        <image class="activity-cover" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="activity-overlay">
          <text class="activity-title">{{item.title}}</text>
          <text class="activity-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
        </view>
        <view class="activity-tag activity-tag-{{item.type}}">
          <text wx:if="{{item.type === 'festival'}}">节日促销</text>
          <text wx:if="{{item.type === 'newbie'}}">新人专享</text>
          <text wx:if="{{item.type === 'vip'}}">会员专区</text>
          <text wx:if="{{item.type === 'group'}}">拼团活动</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 分类导航 -->
  <view class="category-nav" wx:if="{{categories.length > 0}}">
    <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">
      <image class="category-icon" src="{{item.icon}}" mode="aspectFill"></image>
      <text class="category-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 热门商品 -->
  <view class="product-section">
    <view class="section-header">
      <text class="section-title">🔥 热门推荐</text>
    </view>
    <view class="product-grid">
      <view class="product-item" wx:for="{{hotProducts}}" wx:key="id" bindtap="goProductDetail" data-id="{{item.id}}">
        <image class="product-image" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="product-tags">
          <text class="tag tag-hot" wx:if="{{item.is_hot}}">HOT</text>
          <text class="tag tag-new" wx:if="{{item.is_new}}">NEW</text>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
          <view class="product-bottom">
            <view class="product-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
              <text class="price-original" wx:if="{{item.original_price}}">¥{{item.original_price}}</text>
            </view>
            <view class="cart-btn" catchtap="handleAddToCart" data-id="{{item.id}}">
              <text class="cart-icon">🛒</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 新品上市 -->
  <view class="product-section">
    <view class="section-header">
      <text class="section-title">✨ 新品上市</text>
    </view>
    <view class="product-grid">
      <view class="product-item" wx:for="{{newProducts}}" wx:key="id" bindtap="goProductDetail" data-id="{{item.id}}">
        <image class="product-image" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="product-tags">
          <text class="tag tag-new">NEW</text>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
          <view class="product-bottom">
            <view class="product-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
            </view>
            <view class="cart-btn" catchtap="handleAddToCart" data-id="{{item.id}}">
              <text class="cart-icon">🛒</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && hotProducts.length === 0 && newProducts.length === 0}}" style="min-height: calc(100vh - {{navBarHeight + 80}}px);">
    <text class="empty-text">暂无商品</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
