/* pages/index/index.wxss */
.index-page {
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); /* TabBar高度 + 安全区 */
  box-sizing: border-box;
}

/* 自定义导航栏 */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 101;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8c5a 100%);
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 0, 0.15);
}

.nav-content {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 20rpx;
}

/* Logo区域 */
.nav-logo-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  max-width: 100%;
}

.logo-circle {
  width: 76rpx;
  height: 76rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.2);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.logo-text {
  font-size: 30rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8c5a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.nav-text-area {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  flex: 1;
}

.nav-title {
  font-size: 34rpx;
  color: white;
  font-weight: bold;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nav-slogan {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 响应式 - 超小屏 (iPhone SE 等) */
@media screen and (max-width: 375px) {
  .nav-content {
    padding: 0 16rpx;
  }
  
  .nav-logo-area {
    gap: 10rpx;
  }
  
  .logo-circle {
    width: 64rpx;
    height: 64rpx;
  }
  
  .logo-text {
    font-size: 26rpx;
  }
  
  .nav-title {
    font-size: 28rpx;
  }
  
  .nav-slogan {
    font-size: 18rpx;
  }
}

/* 响应式 - 小屏 (iPhone 12/13 mini, 标准手机) */
@media screen and (min-width: 375px) and (max-width: 640rpx) {
  .nav-content {
    padding: 0 18rpx;
  }
  
  .nav-logo-area {
    gap: 12rpx;
  }
  
  .logo-circle {
    width: 70rpx;
    height: 70rpx;
  }
  
  .logo-text {
    font-size: 28rpx;
  }
  
  .nav-title {
    font-size: 32rpx;
  }
  
  .nav-slogan {
    font-size: 20rpx;
  }
}

/* 响应式 - 中屏 (iPhone 12/13 Pro, 大屏手机) */
@media screen and (min-width: 640rpx) and (max-width: 1024rpx) {
  .nav-content {
    padding: 0 24rpx;
  }
  
  .nav-logo-area {
    gap: 16rpx;
  }
  
  .logo-circle {
    width: 80rpx;
    height: 80rpx;
  }
  
  .logo-text {
    font-size: 32rpx;
  }
  
  .nav-title {
    font-size: 36rpx;
  }
  
  .nav-slogan {
    font-size: 22rpx;
  }
}

/* 响应式 - 大屏 (iPad, 平板) */
@media screen and (min-width: 1024rpx) {
  .nav-content {
    padding: 0 40rpx;
  }
  
  .nav-logo-area {
    gap: 20rpx;
  }
  
  .logo-circle {
    width: 96rpx;
    height: 96rpx;
  }
  
  .logo-text {
    font-size: 38rpx;
  }
  
  .nav-title {
    font-size: 42rpx;
  }
  
  .nav-slogan {
    font-size: 26rpx;
  }
}

/* 搜索栏 */
.search-bar {
  position: fixed;
  top: calc(88rpx + env(safe-area-inset-top));
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #FF6B00;
  padding: 20rpx;
}

.search-input {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
  text-align: center;
}

/* 轮播图 */
.banner-container {
  margin: 20rpx 20rpx 0;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 分类导航 */
.category-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 30rpx 20rpx;
  background-color: #fff;
  margin: 20rpx 20rpx 0;
  border-radius: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
}

/* 优惠券 */
.coupon-section {
  margin: 20rpx 20rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.icon-arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.coupon-list {
  white-space: nowrap;
}

.coupon-item {
  display: inline-flex;
  width: 560rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 16rpx;
  margin-right: 20rpx;
  overflow: hidden;
}

.coupon-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 200rpx;
  border-right: 2rpx dashed rgba(255, 255, 255, 0.5);
  color: #fff;
}

.coupon-amount {
  display: flex;
  align-items: baseline;
}

.coupon-symbol {
  font-size: 28rpx;
  margin-right: 4rpx;
}

.coupon-value {
  font-size: 56rpx;
  font-weight: bold;
}

.coupon-condition {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 24rpx;
  color: #fff;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.coupon-time {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 商品区域 */
.product-section {
  margin: 20rpx 20rpx 20rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

@media screen and (min-width: 768px) {
  .product-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media screen and (min-width: 1024px) {
  .product-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.product-item {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 340rpx;
  background-color: #f5f5f5;
}

.product-tags {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  display: flex;
  gap: 8rpx;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  height: 80rpx;
  line-height: 40rpx;
}

.product-subtitle {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
  color: #FF6B00;
}

.price-symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
}

.price-original {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

/* 购物车按钮 */
.cart-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #ff6b00 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.cart-icon {
  font-size: 28rpx;
}

/* 标签 */
.tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  color: white;
}

.tag-hot {
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
}

.tag-new {
  background: linear-gradient(135deg, #1989fa 0%, #38a3ff 100%);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}
