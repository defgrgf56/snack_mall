/* pages/index/index.wxss */
.index-page {
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); /* TabBar高度 + 安全区 */
  box-sizing: border-box;
}

/* 自定义导航栏 */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 101;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8c5a 100%);
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 0, 0.15);
}

.nav-content {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 20rpx;
}

/* Logo区域 */
.nav-logo-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  max-width: 100%;
}

.logo-circle {
  width: 76rpx;
  height: 76rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.2);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.logo-text {
  font-size: 30rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8c5a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.nav-text-area {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  flex: 1;
}

.nav-title {
  font-size: 34rpx;
  color: white;
  font-weight: bold;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nav-slogan {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧小Logo(自适应位置,不覆盖微信胶囊) */
.nav-right-logo {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.right-logo-circle {
  width: 56rpx;
  height: 56rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.right-logo-text {
  font-size: 22rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8c5a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 响应式 - 超小屏 (iPhone SE 等) */
@media screen and (max-width: 375px) {
  .nav-content {
    padding: 0 16rpx;
  }
  
  .nav-logo-area {
    gap: 10rpx;
  }
  
  .logo-circle {
    width: 64rpx;
    height: 64rpx;
  }
  
  .logo-text {
    font-size: 26rpx;
  }
  
  .nav-title {
    font-size: 28rpx;
  }
  
  .nav-slogan {
    font-size: 18rpx;
  }
  
  .right-logo-circle {
    width: 48rpx;
    height: 48rpx;
  }
  
  .right-logo-text {
    font-size: 20rpx;
  }
}

/* 响应式 - 小屏 (iPhone 12/13 mini, 标准手机) */
@media screen and (min-width: 375px) and (max-width: 640rpx) {
  .nav-content {
    padding: 0 18rpx;
  }
  
  .nav-logo-area {
    gap: 12rpx;
  }
  
  .logo-circle {
    width: 70rpx;
    height: 70rpx;
  }
  
  .logo-text {
    font-size: 28rpx;
  }
  
  .nav-title {
    font-size: 32rpx;
  }
  
  .nav-slogan {
    font-size: 20rpx;
  }
  
  .right-logo-circle {
    width: 52rpx;
    height: 52rpx;
  }
  
  .right-logo-text {
    font-size: 22rpx;
  }
}

/* 响应式 - 中屏 (iPhone 12/13 Pro, 大屏手机) */
@media screen and (min-width: 640rpx) and (max-width: 1024rpx) {
  .nav-content {
    padding: 0 24rpx;
  }
  
  .nav-logo-area {
    gap: 16rpx;
  }
  
  .logo-circle {
    width: 80rpx;
    height: 80rpx;
  }
  
  .logo-text {
    font-size: 32rpx;
  }
  
  .nav-title {
    font-size: 36rpx;
  }
  
  .nav-slogan {
    font-size: 22rpx;
  }
  
  .right-logo-circle {
    width: 58rpx;
    height: 58rpx;
  }
  
  .right-logo-text {
    font-size: 24rpx;
  }
}

/* 响应式 - 大屏 (iPad, 平板) */
@media screen and (min-width: 1024rpx) {
  .nav-content {
    padding: 0 40rpx;
  }
  
  .nav-logo-area {
    gap: 20rpx;
  }
  
  .logo-circle {
    width: 96rpx;
    height: 96rpx;
  }
  
  .logo-text {
    font-size: 38rpx;
  }
  
  .nav-title {
    font-size: 42rpx;
  }
  
  .nav-slogan {
    font-size: 26rpx;
  }
  
  .right-logo-circle {
    width: 68rpx;
    height: 68rpx;
  }
  
  .right-logo-text {
    font-size: 28rpx;
  }
}

/* 搜索栏 */
.search-bar {
  position: fixed;
  top: calc(88rpx + env(safe-area-inset-top));
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #FF6B00;
  padding: 20rpx;
}

.search-input {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
  text-align: center;
}

/* 轮播图 */
.banner-container {
  margin: 20rpx 20rpx 0;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 分类导航 */
.category-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 30rpx 20rpx;
  background-color: #fff;
  margin: 20rpx 20rpx 0;
  border-radius: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
}

/* 优惠券领取中心 */
.coupon-section {
  margin: 20rpx 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
}

.coupon-scroll {
  white-space: nowrap;
}

.coupon-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 20rpx;
}

.coupon-item {
  display: inline-block;
  width: 560rpx;
  flex-shrink: 0;
}

.coupon-content {
  display: flex;
  height: 160rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.coupon-content::before,
.coupon-content::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background: #fff;
  border-radius: 50%;
  left: 195rpx;
}

.coupon-content::before {
  top: -10rpx;
}

.coupon-content::after {
  bottom: -10rpx;
}

.coupon-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 200rpx;
  color: #fff;
}

.coupon-amount-box {
  display: flex;
  align-items: baseline;
}

.coupon-symbol {
  font-size: 32rpx;
  font-weight: bold;
}

.coupon-amount {
  font-size: 64rpx;
  font-weight: bold;
  line-height: 1;
}

.coupon-unit {
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 4rpx;
}

.coupon-condition {
  font-size: 22rpx;
  margin-top: 12rpx;
  opacity: 0.9;
}

.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  color: #fff;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: bold;
}

.coupon-time {
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.coupon-btn {
  align-self: flex-end;
  background: transparent;
  border: 2rpx solid #fff;
  border-radius: 50rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: bold;
}

.coupon-btn:active {
  background: rgba(255, 255, 255, 0.2);
}

/* 限时秒杀 */
.seckill-section {
  margin: 20rpx 20rpx 0;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  border-radius: 16rpx;
  padding: 24rpx 0;
}

.seckill-header {
  padding: 0 24rpx 20rpx;
}

.seckill-title-box {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.seckill-title {
  color: #fff !important;
}

.seckill-countdown {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.countdown-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.countdown-time {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.time-unit {
  background: rgba(0, 0, 0, 0.3);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  min-width: 40rpx;
  text-align: center;
}

.time-sep {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.seckill-scroll {
  white-space: nowrap;
}

.seckill-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 20rpx;
}

.seckill-item {
  display: inline-block;
  width: 280rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.seckill-image {
  width: 100%;
  height: 280rpx;
  background: #f5f5f5;
}

.seckill-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-weight: bold;
}

.seckill-info {
  padding: 16rpx;
}

.seckill-product-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  height: 72rpx;
  line-height: 36rpx;
}

.seckill-price-box {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 12rpx;
}

.seckill-price {
  display: flex;
  align-items: baseline;
  color: #ff6b00;
}

.seckill-price .price-symbol {
  font-size: 22rpx;
  font-weight: bold;
}

.seckill-price .price-value {
  font-size: 32rpx;
  font-weight: bold;
}

.seckill-original-price {
  font-size: 20rpx;
  color: #999;
  text-decoration: line-through;
}

.seckill-progress {
  margin-top: 16rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6b00 0%, #ff8533 100%);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
}

/* 活动专区 */
.activity-section {
  margin: 20rpx 20rpx 0;
}

.activity-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.activity-item {
  position: relative;
  height: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.activity-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.activity-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
  color: #fff;
}

.activity-title {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 4rpx;
}

.activity-subtitle {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
}

.activity-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 50rpx;
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
  backdrop-filter: blur(10rpx);
}

.activity-tag-festival {
  background: rgba(255, 107, 0, 0.9);
}

.activity-tag-newbie {
  background: rgba(25, 137, 250, 0.9);
}

.activity-tag-vip {
  background: rgba(255, 193, 7, 0.9);
}

.activity-tag-group {
  background: rgba(244, 67, 54, 0.9);
}

/* 响应式 - 活动专区 */
@media screen and (min-width: 768rpx) {
  .activity-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  
  .activity-item {
    height: 260rpx;
  }
}

@media screen and (min-width: 1024rpx) {
  .activity-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  
  .activity-item {
    height: 280rpx;
  }
}

/* 商品区域 */
.product-section {
  margin: 20rpx 20rpx 20rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

@media screen and (min-width: 768px) {
  .product-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media screen and (min-width: 1024px) {
  .product-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.product-item {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 340rpx;
  background-color: #f5f5f5;
}

.product-tags {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  display: flex;
  gap: 8rpx;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  height: 80rpx;
  line-height: 40rpx;
}

.product-subtitle {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
  color: #FF6B00;
}

.price-symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
}

.price-original {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

/* 购物车按钮 */
.cart-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #ff6b00 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.cart-icon {
  font-size: 28rpx;
}

/* 标签 */
.tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  color: white;
}

.tag-hot {
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
}

.tag-new {
  background: linear-gradient(135deg, #1989fa 0%, #38a3ff 100%);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}
