/* pages/tasks/tasks.wxss */
page {
  background: #f5f5f5;
}

.tasks-page {
  padding: 20rpx;
}

/* 任务概况 */
.summary-card {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C3A 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 0, 0.2);
}

.summary-item {
  text-align: center;
  color: white;
}

.summary-value {
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1;
  margin-bottom: 12rpx;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.summary-divider {
  width: 2rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

/* 标签栏 */
.tabs {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C3A 100%);
  color: white;
  font-weight: 500;
}

/* 任务列表 */
.tasks-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 任务头部 */
.task-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.task-icon {
  font-size: 48rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF5F0;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-points {
  text-align: right;
  flex-shrink: 0;
}

.points-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B00;
}

.points-unit {
  font-size: 22rpx;
  color: #FF6B00;
  margin-left: 4rpx;
}

/* 任务进度 */
.task-progress {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B00 0%, #FF8C3A 100%);
  border-radius: 6rpx;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: width;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
  min-width: 100rpx;
  text-align: right;
}

/* 任务底部 */
.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-type {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
  background: #f8f8f8;
  border-radius: 20rpx;
}

.btn-action {
  padding: 0 40rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
  border: none;
  transition: all 0.2s ease;
}

.btn-action:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.btn-go {
  background: #f0f0f0;
  color: #666;
}

.btn-claim {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C3A 100%);
  color: white;
  font-weight: 500;
}

.task-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.task-status.completed {
  background: #e8f5e9;
  color: #4caf50;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}
