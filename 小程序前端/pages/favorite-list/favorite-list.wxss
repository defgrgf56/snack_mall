/* pages/favorite-list/favorite-list.wxss */
.favorite-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 统计信息栏 */
.stats-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.stats-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.edit-btn {
  font-size: 28rpx;
  color: #ff6b00;
  padding: 8rpx 20rpx;
  min-width: 80rpx;
  text-align: center;
}

/* 收藏列表 */
.favorite-list {
  padding: 0;
}

.favorite-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background-color: #fff;
  padding: 24rpx 30rpx;
  padding-right: 120rpx; /* 为右侧按钮留出空间 */
  margin-bottom: 20rpx;
  position: relative;
  transition: all 0.3s;
  box-sizing: border-box;
}

.favorite-item:active {
  background-color: #fafafa;
}

/* 选择框 */
.item-checkbox {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* 商品内容 */
.item-content {
  flex: 1;
  display: flex;
  gap: 20rpx;
  min-width: 0;
  max-width: 100%;
}

.product-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  max-width: 100%;
  padding: 8rpx 0;
}

.product-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
  margin-bottom: 8rpx;
}

.product-sales {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.product-stock {
  margin: 8rpx 0;
}

.stock-warning {
  display: inline-block;
  font-size: 22rpx;
  color: #ff6b00;
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.product-footer {
  display: flex;
  justify-content: flex-start;
  align-items: flex-end;
  margin-top: auto;
  flex-wrap: wrap;
  gap: 8rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-wrap: wrap;
}

.price-symbol {
  font-size: 24rpx;
  color: #ff6b00;
  font-weight: bold;
}

.price-current {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b00;
  line-height: 1;
}

.price-original {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 6rpx;
}

/* 操作按钮 */
.item-actions {
  position: absolute;
  bottom: 30rpx;
  right: 30rpx;
}

.btn-add-cart {
  width: 70rpx;
  height: 70rpx;
  background: #ff6b00;
  color: #fff;
  font-size: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.25);
  flex-shrink: 0;
  border: none;
  padding: 0;
}

.btn-add-cart::after {
  border: none;
}

.cart-icon {
  font-size: 32rpx;
  line-height: 1;
}

.btn-add-cart:active {
  opacity: 0.8;
  transform: scale(0.95);
}

/* 删除按钮 */
.item-delete {
  position: absolute;
  bottom: 30rpx;
  right: 30rpx;
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 垃圾桶图标 */
.delete-icon {
  width: 32rpx;
  height: 36rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.5;
}

/* 垃圾桶盖子 */
.delete-icon-lid {
  width: 32rpx;
  height: 4rpx;
  background: #999;
  border-radius: 2rpx;
  position: relative;
}

.delete-icon-lid::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 4rpx;
  background: #999;
  border-radius: 2rpx;
}

/* 垃圾桶身体 */
.delete-icon-body {
  width: 26rpx;
  height: 28rpx;
  border: 2rpx solid #999;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  position: relative;
  margin-top: 2rpx;
}

.delete-icon-body::before,
.delete-icon-body::after {
  content: '';
  position: absolute;
  width: 2rpx;
  height: 16rpx;
  background: #999;
  top: 4rpx;
}

.delete-icon-body::before {
  left: 6rpx;
}

.delete-icon-body::after {
  right: 6rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 30rpx;
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 50rpx;
  text-align: center;
}

.empty-btn {
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.3);
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 60rpx 30rpx;
  font-size: 28rpx;
  color: #999;
  background-color: #fff;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 60rpx 30rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  box-sizing: border-box;
}

.bar-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.select-all-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
}

.bar-right {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.btn-batch-cart,
.btn-batch-delete {
  padding: 18rpx 32rpx;
  font-size: 28rpx;
  border-radius: 50rpx;
  border: none;
  line-height: 1;
  transition: all 0.3s;
  white-space: nowrap;
}

.btn-batch-cart {
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.btn-batch-cart[disabled] {
  background: #e0e0e0;
  color: #999;
  box-shadow: none;
}

.btn-batch-delete {
  background: #f5f5f5;
  color: #666;
}

.btn-batch-delete[disabled] {
  background: #f5f5f5;
  color: #ccc;
}

.btn-batch-delete:not([disabled]):active {
  background: #e0e0e0;
}

/* 响应式调整 - 小屏幕 */
@media screen and (max-width: 640rpx) {
  .favorite-item {
    padding: 20rpx 24rpx;
    padding-right: 100rpx;
  }
  
  .product-image {
    width: 150rpx;
    height: 150rpx;
  }
  
  .product-name {
    font-size: 28rpx;
  }
  
  .product-sales {
    font-size: 22rpx;
  }
  
  .price-current {
    font-size: 32rpx;
  }
  
  .price-symbol,
  .price-original {
    font-size: 22rpx;
  }
  
  .btn-add-cart {
    width: 60rpx;
    height: 60rpx;
  }
  
  .cart-icon {
    font-size: 28rpx;
  }
  
  .item-actions,
  .item-delete {
    bottom: 24rpx;
    right: 24rpx;
  }
  
  .bottom-bar {
    padding: 16rpx 24rpx;
    padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  }
  
  .btn-batch-cart,
  .btn-batch-delete {
    padding: 14rpx 24rpx;
    font-size: 26rpx;
  }
}

/* 响应式调整 - 大屏幕 */
@media screen and (min-width: 1024rpx) {
  .favorite-item {
    padding: 28rpx 40rpx;
    padding-right: 140rpx;
  }
  
  .product-image {
    width: 200rpx;
    height: 200rpx;
  }
  
  .product-name {
    font-size: 32rpx;
  }
  
  .product-sales {
    font-size: 26rpx;
  }
  
  .price-current {
    font-size: 40rpx;
  }
  
  .price-symbol,
  .price-original {
    font-size: 26rpx;
  }
  
  .btn-add-cart {
    width: 80rpx;
    height: 80rpx;
  }
  
  .cart-icon {
    font-size: 36rpx;
  }
  
  .item-actions,
  .item-delete {
    bottom: 36rpx;
    right: 40rpx;
  }
  
  .delete-icon {
    width: 36rpx;
    height: 40rpx;
  }
  
  .delete-icon-lid {
    width: 36rpx;
  }
  
  .delete-icon-body {
    width: 30rpx;
    height: 32rpx;
  }
  
  .bottom-bar {
    padding: 24rpx 40rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  }
  
  .btn-batch-cart,
  .btn-batch-delete {
    padding: 20rpx 40rpx;
    font-size: 30rpx;
  }
}