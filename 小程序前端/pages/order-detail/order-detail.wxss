/* pages/order-detail/order-detail.wxss */
.order-detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.order-content {
  height: calc(100vh - 120rpx);
}

/* 订单状态 */
.status-section {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  padding: 60rpx 30rpx;
  color: #fff;
}

.status-section.cancelled,
.status-section.refunded {
  background: linear-gradient(135deg, #999 0%, #aaa 100%);
}

.status-text {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.status-tip {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 收货地址 */
.address-section,
.pickup-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.address-info,
.pickup-info {
  padding-left: 20rpx;
  border-left: 4rpx solid #ff6b35;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.consignee {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail,
.pickup-address {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.pickup-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

/* 商品列表 */
.product-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.product-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 28rpx;
  color: #333;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
}

/* 订单信息 */
.info-section,
.price-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.info-list,
.price-list {
  margin-top: 20rpx;
}

.info-item,
.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.info-item:last-child,
.price-item:last-child {
  margin-bottom: 0;
}

.info-label,
.price-label {
  color: #666;
}

.info-value {
  color: #333;
  display: flex;
  align-items: center;
}

.copy-btn {
  margin-left: 20rpx;
  color: #ff6b35;
  font-size: 24rpx;
}

.price-value {
  color: #333;
}

.price-value.discount {
  color: #ff6b35;
}

.price-item.total {
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.price-value.final {
  color: #ff6b35;
  font-size: 36rpx;
}

/* 联系客服 */
.contact-section {
  padding: 30rpx;
}

.contact-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #fff;
  color: #ff6b35;
  border: 1rpx solid #ff6b35;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 底部操作 */
.order-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  margin-left: 20rpx;
  background-color: #fff;
}

.action-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  border-color: #ff6b35;
}
