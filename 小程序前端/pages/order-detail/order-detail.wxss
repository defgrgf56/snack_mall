/* pages/order-detail/order-detail.wxss */
.order-detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.order-content {
  height: calc(100vh - 120rpx - env(safe-area-inset-bottom));
}

/* 订单状态 */
.status-section {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  padding: 60rpx 30rpx;
  color: #fff;
}

.status-section.cancelled,
.status-section.refunded {
  background: linear-gradient(135deg, #999 0%, #aaa 100%);
}

.status-text {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.status-tip {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 收货地址 */
.address-section,
.pickup-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.address-info,
.pickup-info {
  padding-left: 20rpx;
  border-left: 4rpx solid #ff6b35;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.consignee {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail,
.pickup-address {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.pickup-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

/* 商品列表 */
.product-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.product-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 28rpx;
  color: #333;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
}

/* 订单信息 */
.info-section,
.price-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.info-list,
.price-list {
  margin-top: 20rpx;
}

.info-item,
.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.info-item:last-child,
.price-item:last-child {
  margin-bottom: 0;
}

.info-label,
.price-label {
  color: #666;
}

.info-value {
  color: #333;
  display: flex;
  align-items: center;
}

.copy-btn {
  margin-left: 20rpx;
  color: #ff6b35;
  font-size: 24rpx;
}

.price-value {
  color: #333;
}

.price-value.discount {
  color: #ff6b35;
}

.price-item.total {
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.price-value.final {
  color: #ff6b35;
  font-size: 36rpx;
}

/* 联系客服 */
.contact-section {
  padding: 30rpx;
}

.contact-btn {
  width: 100%;
  height: 80rpx;
  background-color: #fff;
  color: #ff6b35;
  border: 1rpx solid #ff6b35;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-btn::after {
  border: none;
}

/* 底部操作 */
.order-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 30rpx calc(0rpx + env(safe-area-inset-bottom)) 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  margin-left: 20rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  border-color: #ff6b35;
}

/* ==================== 响应式设计 ==================== */

/* 小屏设备 (≤640rpx) - 手机竖屏 */
@media (max-width: 640rpx) {
  .status-section {
    padding: 50rpx 24rpx;
  }

  .status-text {
    font-size: 42rpx;
  }

  .status-tip {
    font-size: 24rpx;
  }

  .address-section,
  .pickup-section,
  .product-section,
  .info-section,
  .price-section {
    padding: 24rpx;
    margin-top: 16rpx;
  }

  .section-title {
    font-size: 26rpx;
    margin-bottom: 16rpx;
  }

  .consignee {
    font-size: 28rpx;
  }

  .phone {
    font-size: 26rpx;
  }

  .address-detail,
  .pickup-address {
    font-size: 24rpx;
  }

  .product-image {
    width: 140rpx;
    height: 140rpx;
    margin-right: 16rpx;
  }

  .product-name {
    font-size: 26rpx;
  }

  .product-spec {
    font-size: 22rpx;
  }

  .product-price {
    font-size: 26rpx;
  }

  .product-quantity {
    font-size: 22rpx;
  }

  .info-item,
  .price-item {
    font-size: 24rpx;
    margin-bottom: 20rpx;
  }

  .price-item.total {
    font-size: 28rpx;
  }

  .price-value.final {
    font-size: 32rpx;
  }

  .contact-section {
    padding: 24rpx;
  }

  .contact-btn {
    height: 76rpx;
    font-size: 26rpx;
  }

  .order-footer {
    padding: 0 24rpx calc(0rpx + env(safe-area-inset-bottom)) 24rpx;
  }

  .action-btn {
    padding: 14rpx 32rpx;
    font-size: 26rpx;
    margin-left: 16rpx;
  }
}

/* 中等屏幕 (640rpx - 1024rpx) - 大屏手机/小平板 */
@media (min-width: 640rpx) and (max-width: 1024rpx) {
  .status-section {
    padding: 70rpx 40rpx;
  }

  .status-text {
    font-size: 52rpx;
  }

  .status-tip {
    font-size: 28rpx;
  }

  .address-section,
  .pickup-section,
  .product-section,
  .info-section,
  .price-section {
    padding: 40rpx;
    margin-top: 24rpx;
  }

  .section-title {
    font-size: 32rpx;
    margin-bottom: 24rpx;
  }

  .consignee {
    font-size: 36rpx;
  }

  .phone {
    font-size: 30rpx;
  }

  .address-detail,
  .pickup-address {
    font-size: 28rpx;
  }

  .product-image {
    width: 180rpx;
    height: 180rpx;
    margin-right: 24rpx;
  }

  .product-name {
    font-size: 30rpx;
  }

  .product-spec {
    font-size: 26rpx;
  }

  .product-price {
    font-size: 30rpx;
  }

  .product-quantity {
    font-size: 26rpx;
  }

  .info-item,
  .price-item {
    font-size: 28rpx;
    margin-bottom: 28rpx;
  }

  .price-item.total {
    font-size: 36rpx;
  }

  .price-value.final {
    font-size: 40rpx;
  }

  .contact-section {
    padding: 40rpx;
  }

  .contact-btn {
    height: 88rpx;
    font-size: 30rpx;
    border-radius: 44rpx;
  }

  .order-footer {
    height: 110rpx;
    padding: 0 40rpx calc(0rpx + env(safe-area-inset-bottom)) 40rpx;
  }

  .action-btn {
    padding: 18rpx 48rpx;
    font-size: 30rpx;
    margin-left: 24rpx;
    border-radius: 44rpx;
  }
}

/* 大屏设备 (≥1024rpx) - 平板横屏/Pad */
@media (min-width: 1024rpx) {
  .order-detail-container {
    max-width: 1200rpx;
    margin: 0 auto;
  }

  .status-section {
    padding: 80rpx 60rpx;
    border-radius: 16rpx;
    margin: 20rpx;
  }

  .status-text {
    font-size: 56rpx;
  }

  .status-tip {
    font-size: 30rpx;
  }

  .address-section,
  .pickup-section,
  .product-section,
  .info-section,
  .price-section {
    padding: 50rpx 60rpx;
    margin: 20rpx;
    border-radius: 16rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  }

  .section-title {
    font-size: 34rpx;
    margin-bottom: 28rpx;
  }

  .address-info,
  .pickup-info {
    padding-left: 24rpx;
    border-left: 6rpx solid #ff6b35;
  }

  .consignee {
    font-size: 38rpx;
  }

  .phone {
    font-size: 32rpx;
  }

  .address-detail,
  .pickup-address {
    font-size: 30rpx;
  }

  .product-item {
    padding: 28rpx 0;
  }

  .product-image {
    width: 200rpx;
    height: 200rpx;
    margin-right: 28rpx;
    border-radius: 16rpx;
  }

  .product-name {
    font-size: 32rpx;
  }

  .product-spec {
    font-size: 28rpx;
  }

  .product-price {
    font-size: 32rpx;
  }

  .product-quantity {
    font-size: 28rpx;
  }

  .info-item,
  .price-item {
    font-size: 30rpx;
    margin-bottom: 32rpx;
  }

  .copy-btn {
    margin-left: 24rpx;
    font-size: 26rpx;
  }

  .price-item.total {
    font-size: 38rpx;
    padding-top: 24rpx;
    margin-top: 24rpx;
  }

  .price-value.final {
    font-size: 44rpx;
  }

  .contact-section {
    padding: 30rpx 60rpx 50rpx;
    margin: 20rpx;
  }

  .contact-btn {
    max-width: 600rpx;
    margin: 0 auto;
    height: 96rpx;
    font-size: 32rpx;
    border-radius: 48rpx;
    border: 2rpx solid #ff6b35;
  }

  .order-footer {
    max-width: 1200rpx;
    left: 50%;
    transform: translateX(-50%);
    height: 120rpx;
    padding: 0 60rpx calc(0rpx + env(safe-area-inset-bottom)) 60rpx;
  }

  .action-btn {
    padding: 20rpx 56rpx;
    font-size: 32rpx;
    margin-left: 28rpx;
    border-radius: 48rpx;
  }
}

