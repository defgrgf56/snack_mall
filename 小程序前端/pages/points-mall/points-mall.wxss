/* pages/points-mall/points-mall.wxss */
page {
  background-color: #f5f5f5;
}

.points-mall {
  padding-bottom: 20rpx;
}

/* 顶部积分展示 */
.points-header {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C3A 100%);
  padding: 40rpx 30rpx;
  color: white;
}

.points-info {
  text-align: center;
  margin-bottom: 30rpx;
}

.points-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.points-value {
  font-size: 80rpx;
  font-weight: bold;
  line-height: 1;
}

.points-actions {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 15rpx 30rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  font-size: 26rpx;
}

.action-btn .icon {
  font-size: 32rpx;
}

/* 商品列表 */
.products-container {
  padding: 20rpx;
}

.products-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.product-item {
  width: calc(50% - 10rpx);
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.product-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.product-image {
  width: 100%;
  height: 280rpx;
  display: block;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-points {
  color: #FF6B00;
  font-weight: bold;
}

.points-num {
  font-size: 32rpx;
}

.points-unit {
  font-size: 22rpx;
  margin-left: 4rpx;
}

.product-stock {
  font-size: 22rpx;
  color: #999;
}

.product-limit {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #FF6B00;
  background: #FFF5F0;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
}

/* 加载状态 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}
