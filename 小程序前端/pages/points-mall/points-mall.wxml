<!--pages/points-mall/points-mall.wxml-->
<view class="points-mall">
  <!-- 顶部积分展示 -->
  <view class="points-header">
    <view class="points-info">
      <view class="points-label">我的积分</view>
      <view class="points-value">{{userPoints}}</view>
    </view>
    <view class="points-actions">
      <view class="action-btn" bindtap="onPointsDetailTap">
        <text class="icon">📊</text>
        <text class="text">积分明细</text>
      </view>
      <view class="action-btn" bindtap="onRecordTap">
        <text class="icon">📝</text>
        <text class="text">兑换记录</text>
      </view>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="products-container">
    <view class="products-list">
      <view 
        class="product-item" 
        wx:for="{{products}}" 
        wx:key="id"
        bindtap="onProductTap"
        data-id="{{item.id}}"
      >
        <image class="product-image" src="{{item.image}}" mode="aspectFill" />
        <view class="product-info">
          <view class="product-name">{{item.name}}</view>
          <view class="product-desc">{{item.description}}</view>
          <view class="product-footer">
            <view class="product-points">
              <text class="points-num">{{item.points}}</text>
              <text class="points-unit">积分</text>
            </view>
            <view class="product-stock">库存: {{item.stock}}</view>
          </view>
          <view class="product-limit" wx:if="{{item.limit_per_person > 0}}">
            限购{{item.limit_per_person}}件
          </view>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && products.length > 0}}">
      <text>没有更多了</text>
    </view>
    <view class="empty" wx:if="{{products.length === 0 && !loading}}">
      <text class="empty-icon">🎁</text>
      <text class="empty-text">暂无积分商品</text>
    </view>
  </view>
</view>
