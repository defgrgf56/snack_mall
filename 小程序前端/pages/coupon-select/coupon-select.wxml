<!--pages/coupon-select/coupon-select.wxml-->
<view class="coupon-select-page">
  <!-- 可用优惠券 -->
  <view class="section" wx:if="{{availableCoupons.length > 0}}">
    <view class="section-title">可用优惠券</view>
    <view class="coupon-list">
      <view 
        class="coupon-item {{selectedCouponId === item.id ? 'selected' : ''}}" 
        wx:for="{{availableCoupons}}" 
        wx:key="id"
        bindtap="onSelectCoupon"
        data-id="{{item.id}}"
        data-discount="{{item.discount_amount}}"
      >
        <view class="coupon-content">
          <view class="coupon-left">
            <view class="coupon-amount-box">
              <text class="coupon-symbol">¥</text>
              <text class="coupon-amount">{{item.discount_amount}}</text>
            </view>
            <text class="coupon-condition">{{item.coupon.min_amount > 0 ? '满' + item.coupon.min_amount + '元可用' : '无门槛'}}</text>
          </view>
          <view class="coupon-right">
            <text class="coupon-name">{{item.coupon.name}}</text>
            <text class="coupon-time">有效期至 {{item.expire_time}}</text>
          </view>
          <view class="coupon-check" wx:if="{{selectedCouponId === item.id}}">
            <text class="check-icon">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 不可用优惠券 -->
  <view class="section" wx:if="{{unavailableCoupons.length > 0}}">
    <view class="section-title">不可用优惠券</view>
    <view class="coupon-list">
      <view class="coupon-item disabled" wx:for="{{unavailableCoupons}}" wx:key="id">
        <view class="coupon-content">
          <view class="coupon-left">
            <view class="coupon-amount-box">
              <text class="coupon-symbol">¥</text>
              <text class="coupon-amount">{{item.display_amount}}</text>
            </view>
            <text class="coupon-condition">{{item.coupon.min_amount > 0 ? '满' + item.coupon.min_amount + '元可用' : '无门槛'}}</text>
          </view>
          <view class="coupon-right">
            <text class="coupon-name">{{item.coupon.name}}</text>
            <text class="coupon-time">{{item.reason}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{availableCoupons.length === 0 && unavailableCoupons.length === 0 && !loading}}">
    <text class="empty-icon">🎫</text>
    <text class="empty-text">暂无可用优惠券</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 底部按钮 -->
  <view class="footer">
    <button class="cancel-btn" bindtap="onCancel">不使用优惠券</button>
    <button class="confirm-btn" bindtap="onConfirm" disabled="{{!selectedCouponId}}">确定</button>
  </view>
</view>