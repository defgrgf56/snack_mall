/* pages/coupon-select/coupon-select.wxss */
.coupon-select-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  padding: 20rpx 30rpx;
  background-color: #f5f5f5;
}

.coupon-list {
  background-color: #fff;
}

.coupon-item {
  margin: 20rpx 30rpx;
  position: relative;
}

.coupon-item.selected .coupon-content {
  border-color: #ff6b00;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.2);
}

.coupon-item.disabled {
  opacity: 0.5;
}

.coupon-content {
  display: flex;
  height: 160rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.coupon-content::before,
.coupon-content::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background: #f5f5f5;
  border-radius: 50%;
  left: 180rpx;
}

.coupon-content::before {
  top: -10rpx;
}

.coupon-content::after {
  bottom: -10rpx;
}

.coupon-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 180rpx;
  color: #fff;
  flex-shrink: 0;
  padding: 0 16rpx;
}

.coupon-amount-box {
  display: flex;
  align-items: baseline;
}

.coupon-symbol {
  font-size: 32rpx;
  font-weight: bold;
}

.coupon-amount {
  font-size: 64rpx;
  font-weight: bold;
  line-height: 1;
}

.coupon-condition {
  font-size: 22rpx;
  margin-top: 12rpx;
  opacity: 0.9;
}

.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20rpx 60rpx 20rpx 24rpx;
  color: #fff;
  min-width: 0;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: bold;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.coupon-time {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 12rpx;
}

.coupon-check {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  font-size: 32rpx;
  color: #ff6b00;
  font-weight: bold;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
}

.cancel-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  border: 2rpx solid #ddd;
  border-radius: 44rpx;
  color: #666;
  font-size: 28rpx;
  text-align: center;
}

.cancel-btn::after {
  border: none;
}

.confirm-btn {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  border-radius: 44rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  border: none;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn[disabled] {
  background: #ddd;
  color: #999;
}