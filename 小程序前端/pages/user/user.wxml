<!--pages/user/user.wxml-->
<view class="user-container" style="padding-bottom: {{20 + safeAreaBottom + tabBarHeight}}px;">
  <!-- 用户信息卡片 -->
  <view class="user-header">
    <view class="user-info" wx:if="{{userInfo}}">
      <view class="avatar">
        <text class="avatar-emoji">👤</text>
      </view>
      <view class="info-right">
        <text class="nickname">{{userInfo.nickname || '用户' + userInfo.id}}</text>
        <view class="vip-badge" wx:if="{{userInfo.is_vip}}">
          <text>VIP会员</text>
        </view>
      </view>
    </view>
    
    <view class="not-login" wx:else bindtap="onLogin">
      <view class="avatar">
        <text class="avatar-emoji">👤</text>
      </view>
      <text class="login-text">点击登录</text>
    </view>
    
    <!-- 积分信息 -->
    <view class="points-info" wx:if="{{userInfo}}">
      <view class="points-item">
        <text class="points-value">{{userInfo.points || 0}}</text>
        <text class="points-label">积分</text>
      </view>
      <view class="points-item">
        <text class="points-value">{{userInfo.coupon_count || 0}}</text>
        <text class="points-label">优惠券</text>
      </view>
    </view>
  </view>

  <!-- 订单入口 -->
  <view class="order-section">
    <view class="section-header">
      <text class="section-title">我的订单</text>
      <view class="section-more" bindtap="onViewAllOrders">
        <text>查看全部</text>
        <text class="arrow-icon">›</text>
      </view>
    </view>
    
    <view class="order-menu">
      <view class="order-item" bindtap="onViewOrders" data-status="1">
        <text class="order-icon">💰</text>
        <text class="order-text">待付款</text>
        <view class="order-badge" wx:if="{{orderStats.pending > 0}}">{{orderStats.pending}}</view>
      </view>
      <view class="order-item" bindtap="onViewOrders" data-status="2">
        <text class="order-icon">📦</text>
        <text class="order-text">待发货</text>
        <view class="order-badge" wx:if="{{orderStats.paid > 0}}">{{orderStats.paid}}</view>
      </view>
      <view class="order-item" bindtap="onViewOrders" data-status="3">
        <text class="order-icon">🚚</text>
        <text class="order-text">待收货</text>
        <view class="order-badge" wx:if="{{orderStats.shipped > 0}}">{{orderStats.shipped}}</view>
      </view>
      <view class="order-item" bindtap="onViewOrders" data-status="4">
        <text class="order-icon">✅</text>
        <text class="order-text">已完成</text>
        <view class="order-badge" wx:if="{{orderStats.completed > 0}}">{{orderStats.completed}}</view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onNavigate" data-url="/pages/address-list/address-list">
      <view class="menu-left">
        <text class="menu-icon">📍</text>
        <text class="menu-text">收货地址</text>
      </view>
      <text class="arrow-icon">›</text>
    </view>
    
    <view class="menu-item" bindtap="onNavigate" data-url="/pages/coupon-list/coupon-list">
      <view class="menu-left">
        <text class="menu-icon">🎫</text>
        <text class="menu-text">我的优惠券</text>
      </view>
      <text class="arrow-icon">›</text>
    </view>
    
    <view class="menu-item" bindtap="onNavigate" data-url="/pages/points/points">
      <view class="menu-left">
        <text class="menu-icon">⭐</text>
        <text class="menu-text">积分明细</text>
      </view>
      <text class="arrow-icon">›</text>
    </view>
  </view>

  <!-- 其他功能 -->
  <view class="menu-section">
    <!-- 开发测试入口 -->
    <view class="menu-item" bindtap="onNavigate" data-url="/pages/test-api/test-api">
      <view class="menu-left">
        <text class="menu-icon-emoji">🧪</text>
        <text class="menu-text">API测试</text>
        <text class="menu-tag">开发</text>
      </view>
      <text class="arrow-icon">›</text>
    </view>
    
    <view class="menu-item" bindtap="onNavigate" data-url="/pages/feedback/feedback">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-text">意见反馈</text>
      </view>
      <text class="arrow-icon">›</text>
    </view>
    
    <view class="menu-item" bindtap="onNavigate" data-url="/pages/about/about">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
      </view>
      <text class="arrow-icon">›</text>
    </view>
    
    <view class="menu-item" bindtap="onContact">
      <view class="menu-left">
        <text class="menu-icon">👨‍💼</text>
        <text class="menu-text">联系客服</text>
      </view>
      <text class="arrow-icon">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{userInfo}}">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
