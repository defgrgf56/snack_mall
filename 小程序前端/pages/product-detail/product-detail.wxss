/* pages/product-detail/product-detail.wxss */
.product-detail-page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); /* 底部操作栏 + 安全区 */
  box-sizing: border-box;
}

/* 商品轮播 */
.product-swiper {
  width: 100%;
  height: 750rpx;
  background: white;
}

.product-image {
  width: 100%;
  height: 100%;
}

/* 商品信息卡片 */
.product-info-card {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.product-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 32rpx;
  color: #ff6b00;
  font-weight: bold;
}

.price-value {
  font-size: 48rpx;
  color: #ff6b00;
  font-weight: bold;
}

.price-original {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 10rpx;
}

.product-sales {
  font-size: 26rpx;
  color: #999;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.product-subtitle {
  font-size: 28rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 15rpx;
}

.product-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.tag-hot {
  background: #fff5f0;
  color: #ff6b00;
}

.tag-new {
  background: #f0f9ff;
  color: #1989fa;
}

/* 商品规格 */
.product-spec-card {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.spec-row {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.spec-row:last-child {
  border-bottom: none;
}

.spec-label {
  font-size: 28rpx;
  color: #666;
}

.spec-value {
  font-size: 28rpx;
  color: #333;
}

/* 购买数量 */
.quantity-card {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-label {
  font-size: 28rpx;
  color: #333;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}

.quantity-btn.disabled {
  color: #ccc;
  border-color: #eee;
}

.quantity-input {
  width: 100rpx;
  height: 60rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
}

/* 商品详情 */
.product-detail-card {
  background: white;
  padding: 30rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.detail-content {
  line-height: 1.8;
}

.detail-text {
  font-size: 28rpx;
  color: #666;
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-top: 1rpx solid #eee;
  padding: 15rpx 20rpx;
  padding-bottom: calc(15rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.bar-left {
  display: flex;
  gap: 30rpx;
  flex-shrink: 0;
}

@media screen and (max-width: 640rpx) {
  .bar-left {
    gap: 20rpx;
  }
}

.bar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.bar-icon {
  font-size: 44rpx;
}

.bar-text {
  font-size: 22rpx;
  color: #666;
  white-space: nowrap;
}

.bar-right {
  flex: 1;
  display: flex;
  gap: 15rpx;
  margin-left: 30rpx;
  min-width: 0;
}

@media screen and (max-width: 640rpx) {
  .bar-right {
    gap: 10rpx;
    margin-left: 20rpx;
  }
}

.btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  line-height: 80rpx;
  padding: 0;
  min-width: 0;
  white-space: nowrap;
}

@media screen and (max-width: 640rpx) {
  .btn {
    height: 70rpx;
    line-height: 70rpx;
    font-size: 26rpx;
  }
}

.btn-cart {
  background: linear-gradient(135deg, #ffd89b 0%, #ffa940 100%);
  color: white;
}

.btn-buy {
  background: linear-gradient(135deg, #ff9a9e 0%, #ff6b00 100%);
  color: white;
}
