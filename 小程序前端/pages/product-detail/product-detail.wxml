<!--pages/product-detail/product-detail.wxml-->
<view class="product-detail-page">
  <view wx:if="{{!loading && product}}">
    <!-- 商品图片轮播 -->
    <swiper class="product-swiper" indicator-dots circular>
      <swiper-item wx:for="{{product.images}}" wx:key="index">
        <image class="product-image" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>

    <!-- 商品信息 -->
    <view class="product-info-card">
      <view class="product-price-row">
        <view class="product-price">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{product.actual_price || product.price}}</text>
        </view>
        <!-- 原价划线（仅活动商品显示） -->
        <text class="price-original" wx:if="{{product.actual_price && product.actual_price < product.price}}">¥{{product.price}}</text>
        <view class="product-sales">已售{{product.sales || 0}}</view>
      </view>
      
      <view class="product-name">{{product.name}}</view>
      <view class="product-subtitle" wx:if="{{product.subtitle}}">{{product.subtitle}}</view>
      
      <view class="product-tags">
        <text class="tag tag-hot" wx:if="{{product.is_hot}}">🔥 热销</text>
        <text class="tag tag-new" wx:if="{{product.is_new}}">✨ 新品</text>
      </view>
    </view>

    <!-- 商品规格 -->
    <view class="product-spec-card">
      <view class="spec-row">
        <text class="spec-label">库存</text>
        <text class="spec-value">{{product.stock}}件</text>
      </view>
      <view class="spec-row">
        <text class="spec-label">重量</text>
        <text class="spec-value">{{product.weight || '-'}}g</text>
      </view>
    </view>

    <!-- 购买数量 -->
    <view class="quantity-card">
      <text class="quantity-label">购买数量</text>
      <view class="quantity-control">
        <view class="quantity-btn {{quantity <= 1 ? 'disabled' : ''}}" bindtap="handleMinus">
          <text>-</text>
        </view>
        <input class="quantity-input" type="number" value="{{quantity}}" bindinput="handleQuantityInput" />
        <view class="quantity-btn {{quantity >= product.stock ? 'disabled' : ''}}" bindtap="handlePlus">
          <text>+</text>
        </view>
      </view>
    </view>

    <!-- 用户评价 -->
    <view class="review-section" wx:if="{{reviewStats && reviewStats.total > 0}}">
      <!-- 评价统计头部 -->
      <view class="review-header">
        <view class="review-title">用户评价 ({{reviewStats.total}})</view>
        <view class="review-summary">
          <text class="review-rate">{{reviewStats.average_rating}}</text>
          <view class="review-stars">
            <text class="star {{reviewStats.average_rating >= 1 ? 'filled' : ''}}">★</text>
            <text class="star {{reviewStats.average_rating >= 2 ? 'filled' : ''}}">★</text>
            <text class="star {{reviewStats.average_rating >= 3 ? 'filled' : ''}}">★</text>
            <text class="star {{reviewStats.average_rating >= 4 ? 'filled' : ''}}">★</text>
            <text class="star {{reviewStats.average_rating >= 5 ? 'filled' : ''}}">★</text>
          </view>
        </view>
      </view>

      <!-- 评价列表 -->
      <view class="review-list">
        <view class="review-item" wx:for="{{reviews}}" wx:key="id">
          <!-- 用户信息 -->
          <view class="review-user">
            <image class="user-avatar" src="{{item.User.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
            <view class="user-info">
              <view class="user-name">{{item.User.nickname || '匿名用户'}}</view>
              <view class="review-stars-small">
                <text class="star-small {{item.rating >= 1 ? 'filled' : ''}}">★</text>
                <text class="star-small {{item.rating >= 2 ? 'filled' : ''}}">★</text>
                <text class="star-small {{item.rating >= 3 ? 'filled' : ''}}">★</text>
                <text class="star-small {{item.rating >= 4 ? 'filled' : ''}}">★</text>
                <text class="star-small {{item.rating >= 5 ? 'filled' : ''}}">★</text>
              </view>
            </view>
            <view class="review-date">{{item.created_at}}</view>
          </view>

          <!-- 评价内容 -->
          <view class="review-content" wx:if="{{item.content}}">{{item.content}}</view>

          <!-- 评价图片 -->
          <view class="review-images" wx:if="{{item.images && item.images.length > 0}}">
            <image 
              class="review-image" 
              wx:for="{{item.images}}" 
              wx:for-item="img" 
              wx:key="index"
              src="{{img}}" 
              mode="aspectFill"
            ></image>
          </view>

          <!-- 商家回复 -->
          <view class="review-reply" wx:if="{{item.reply}}">
            <view class="reply-label">商家回复：</view>
            <view class="reply-content">{{item.reply}}</view>
          </view>
        </view>
      </view>

      <!-- 查看更多 -->
      <view class="review-more" bindtap="viewAllReviews">
        <text>查看全部评价</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 商品详情 -->
    <view class="product-detail-card">
      <view class="detail-title">商品详情</view>
      <view class="detail-content">
        <text class="detail-text">{{product.description || '暂无详情'}}</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{!loading && product}}">
    <view class="bar-left">
      <view class="bar-btn" bindtap="goHome">
        <text class="bar-icon">🏠</text>
        <text class="bar-text">首页</text>
      </view>
      <view class="bar-btn {{isFavorited ? 'favorited' : ''}}" bindtap="handleFavorite">
        <text class="bar-icon">{{isFavorited ? '❤️' : '🤍'}}</text>
        <text class="bar-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="bar-btn" bindtap="goCart">
        <text class="bar-icon">🛒</text>
        <text class="bar-text">购物车</text>
      </view>
    </view>
    <view class="bar-right">
      <button class="btn btn-cart" bindtap="handleAddToCart">加入购物车</button>
      <button class="btn btn-buy" bindtap="handleBuyNow">立即购买</button>
    </view>
  </view>
</view>
