<!--pages/activity-detail/activity-detail.wxml-->
<view class="activity-detail-page" wx:if="{{!loading && activity}}">
  <!-- 活动头部 -->
  <view class="activity-header">
    <image class="activity-cover" src="{{activity.cover}}" mode="aspectFill"></image>
    <view class="activity-overlay">
      <view class="activity-type-badge activity-type-{{activity.type}}">
        <text wx:if="{{activity.type === 'festival'}}">节日促销</text>
        <text wx:if="{{activity.type === 'newbie'}}">新人专享</text>
        <text wx:if="{{activity.type === 'vip'}}">会员专区</text>
        <text wx:if="{{activity.type === 'group'}}">拼团活动</text>
      </view>
      <text class="activity-title">{{activity.title}}</text>
      <text class="activity-subtitle" wx:if="{{activity.subtitle}}">{{activity.subtitle}}</text>
    </view>
  </view>

  <!-- 活动状态栏 -->
  <view class="activity-status-bar">
    <!-- 进行中 -->
    <view class="status-content" wx:if="{{activity.status === 1}}">
      <view class="status-label">
        <text class="status-icon">⏰</text>
        <text class="status-text">距结束</text>
      </view>
      <view class="countdown-box">
        <view class="countdown-item" wx:if="{{countdown.days > 0}}">
          <text class="countdown-value">{{countdown.days}}</text>
          <text class="countdown-unit">天</text>
        </view>
        <text class="countdown-separator" wx:if="{{countdown.days > 0}}">:</text>
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.hours}}</text>
          <text class="countdown-unit">时</text>
        </view>
        <text class="countdown-separator">:</text>
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.minutes}}</text>
          <text class="countdown-unit">分</text>
        </view>
        <text class="countdown-separator">:</text>
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.seconds}}</text>
          <text class="countdown-unit">秒</text>
        </view>
      </view>
    </view>

    <!-- 未开始 -->
    <view class="status-content" wx:if="{{activity.status === 2}}">
      <view class="status-label">
        <text class="status-icon">⏳</text>
        <text class="status-text">距开始</text>
      </view>
      <view class="countdown-box">
        <view class="countdown-item" wx:if="{{countdown.days > 0}}">
          <text class="countdown-value">{{countdown.days}}</text>
          <text class="countdown-unit">天</text>
        </view>
        <text class="countdown-separator" wx:if="{{countdown.days > 0}}">:</text>
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.hours}}</text>
          <text class="countdown-unit">时</text>
        </view>
        <text class="countdown-separator">:</text>
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.minutes}}</text>
          <text class="countdown-unit">分</text>
        </view>
        <text class="countdown-separator">:</text>
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.seconds}}</text>
          <text class="countdown-unit">秒</text>
        </view>
      </view>
    </view>

    <!-- 已结束 -->
    <view class="status-content status-ended" wx:if="{{activity.status === 0}}">
      <text class="status-icon">✓</text>
      <text class="status-text">活动已结束</text>
    </view>
  </view>

  <!-- 活动描述 -->
  <view class="activity-description" wx:if="{{activity.description}}">
    <view class="section-title">活动详情</view>
    <text class="description-text">{{activity.description}}</text>
  </view>

  <!-- 活动商品列表 -->
  <view class="products-section">
    <view class="section-title">活动商品</view>
    <view class="product-grid">
      <view class="product-item" wx:for="{{products}}" wx:key="id" bindtap="goProductDetail" data-id="{{item.id}}">
        <image class="product-image" src="{{item.cover}}" mode="aspectFill"></image>
        
        <!-- 活动标签 -->
        <view class="product-badge" wx:if="{{item.discount || item.activity_price}}">
          <text wx:if="{{item.discount}}">{{item.discount}}折</text>
          <text wx:if="{{item.activity_price && !item.discount}}">特价</text>
        </view>
        
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <view class="product-price-box">
            <view class="product-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.activity_price || item.price}}</text>
            </view>
            <text class="product-original-price" wx:if="{{item.activity_price}}">¥{{item.price}}</text>
          </view>
          <view class="product-footer">
            <text class="product-sales">已售{{item.sales || 0}}</text>
            <view class="cart-btn" catchtap="handleAddToCart" data-id="{{item.id}}">
              <text class="cart-icon">🛒</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{products.length > 0}}">
      <text wx:if="{{loadingMore}}">加载中...</text>
      <text wx:elif="{{!hasMore}}">没有更多了</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-products" wx:if="{{products.length === 0 && !loading}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无活动商品</text>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-container" wx:if="{{loading}}">
  <text class="loading-text">加载中...</text>
</view>

<!-- 错误状态 -->
<view class="error-container" wx:if="{{error && !loading}}">
  <text class="error-icon">⚠️</text>
  <text class="error-text">{{error.message || '加载失败'}}</text>
  <button class="retry-btn" bindtap="loadActivityData">重试</button>
</view>