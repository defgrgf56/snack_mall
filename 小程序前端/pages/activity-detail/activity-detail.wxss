/* pages/activity-detail/activity-detail.wxss */
.activity-detail-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 活动头部 */
.activity-header {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.activity-cover {
  width: 100%;
  height: 100%;
}

.activity-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, transparent 100%);
  color: #fff;
}

.activity-type-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 50rpx;
  font-size: 22rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  backdrop-filter: blur(10rpx);
}

.activity-type-festival {
  background: rgba(255, 107, 0, 0.9);
}

.activity-type-newbie {
  background: rgba(25, 137, 250, 0.9);
}

.activity-type-vip {
  background: rgba(255, 193, 7, 0.9);
}

.activity-type-group {
  background: rgba(244, 67, 54, 0.9);
}

.activity-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.activity-subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.4;
}

/* 活动状态栏 */
.activity-status-bar {
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  padding: 24rpx 30rpx;
  margin: 0 0 20rpx;
}

.status-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
}

.status-content.status-ended {
  justify-content: center;
  gap: 12rpx;
}

.status-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-icon {
  font-size: 36rpx;
}

.status-text {
  font-size: 28rpx;
  font-weight: bold;
}

.countdown-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.countdown-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  min-width: 60rpx;
}

.countdown-value {
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1;
}

.countdown-unit {
  font-size: 20rpx;
  margin-top: 4rpx;
  opacity: 0.9;
}

.countdown-separator {
  font-size: 28rpx;
  font-weight: bold;
  margin: 0 4rpx;
}

/* 活动描述 */
.activity-description {
  background: #fff;
  padding: 30rpx;
  margin: 0 0 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #ff6b00;
}

.description-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 活动商品列表 */
.products-section {
  background: #fff;
  padding: 30rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.product-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
}

.product-image {
  width: 100%;
  height: 320rpx;
  background: #f5f5f5;
}

.product-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 50rpx;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  height: 80rpx;
  line-height: 40rpx;
}

.product-price-box {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 12rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
  color: #ff6b00;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: bold;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
}

.product-original-price {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

.cart-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #ff6b00 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.cart-icon {
  font-size: 28rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-products {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.error-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.retry-btn {
  padding: 16rpx 60rpx;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: none;
}