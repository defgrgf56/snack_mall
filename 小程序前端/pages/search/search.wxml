<!--pages/search/search.wxml-->
<view class="search-container">
  <!-- 搜索框 -->
  <view class="search-header" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <view class="search-box">
      <view class="search-icon">🔍</view>
      <input 
        class="search-input" 
        placeholder="搜索商品"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
        focus="{{autoFocus}}"
      />
      <text class="clear-input" wx:if="{{keyword}}" bindtap="onClearInput">×</text>
    </view>
    <text class="cancel-btn" bindtap="onCancel">取消</text>
  </view>

  <!-- 搜索联想列表 -->
  <view class="suggestions-list" wx:if="{{showSuggestions && suggestions.length > 0}}">
    <view 
      class="suggestion-item"
      wx:for="{{suggestions}}"
      wx:key="index"
      data-keyword="{{item}}"
      bindtap="onSuggestionTap"
    >
      <text class="suggestion-icon">🔍</text>
      <text class="suggestion-text">{{item}}</text>
    </view>
  </view>

  <!-- 搜索内容区域 -->
  <view class="search-content" wx:if="{{!showSuggestions}}">
    <!-- 搜索历史 -->
    <view class="search-section" wx:if="{{!searching && !searched && history.length > 0}}">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <text class="clear-btn" bindtap="onClearHistory">
          <text class="icon">🗑</text> 清空
        </text>
      </view>
      <view class="tag-list">
        <view 
          class="tag-item history-tag"
          wx:for="{{history}}"
          wx:key="index"
          data-keyword="{{item}}"
          bindtap="onHistoryTap"
        >
          <text class="tag-icon">🕐</text>
          <text class="tag-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 热门搜索 -->
    <view class="search-section" wx:if="{{!searching && !searched && hotKeywords.length > 0}}">
      <view class="section-header">
        <text class="section-title">热门搜索</text>
        <text class="hot-badge">HOT</text>
      </view>
      <view class="tag-list">
        <view 
          class="tag-item hot-tag"
          wx:for="{{hotKeywords}}"
          wx:key="index"
          data-keyword="{{item}}"
          bindtap="onHistoryTap"
        >
          <text class="tag-icon">🔥</text>
          <text class="tag-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 搜索结果 -->
    <view class="search-results" wx:if="{{searched}}">
      <!-- 排序栏 -->
      <view class="sort-bar" wx:if="{{products.length > 0}}">
        <view 
          class="sort-item {{sortType === item.value ? 'active' : ''}}"
          wx:for="{{sortOptions}}"
          wx:key="value"
          wx:for-item="item"
          data-sort="{{item.value}}"
          bindtap="onSortChange"
        >
          <text class="sort-label">{{item.label}}</text>
        </view>
      </view>

      <view class="product-list">
        <view 
          class="product-item"
          wx:for="{{products}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onProductTap"
        >
          <image class="product-image" src="{{item.cover}}" mode="aspectFill" />
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <text class="product-desc" wx:if="{{item.description}}">{{item.description}}</text>
            <view class="product-footer">
              <view class="price-box">
                <text class="price-symbol">¥</text>
                <text class="product-price">{{item.price}}</text>
              </view>
              <view class="product-meta">
                <text class="product-sales">销量 {{item.sales}}</text>
                <text class="product-rating" wx:if="{{item.rating > 0}}">⭐{{item.rating}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-result" wx:if="{{products.length === 0}}">
        <view class="empty-icon">🔍</view>
        <text class="empty-text">没有找到"{{keyword}}"相关商品</text>
        <text class="empty-tip">换个关键词试试吧</text>
      </view>
    </view>
  </view>
</view>
