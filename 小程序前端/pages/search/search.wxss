/* pages/search/search.wxss */
.search-container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 搜索头部 */
.search-header {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

/* 保证搜索框在胶囊下方 */
.search-box {
  margin-top: 8rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 64rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #999;
}

.clear-input {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999;
  margin-left: 16rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: #333;
  margin-left: 24rpx;
  padding: 8rpx 0;
}

/* 搜索联想列表 */
.suggestions-list {
  background-color: #fff;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  margin: 0 24rpx;
  overflow: hidden;
}

.suggestion-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-item:active {
  background-color: #f9f9f9;
}

/* 搜索关键词项 - 突出显示 */
.search-keyword-item {
  background: linear-gradient(90deg, #FFF9F5 0%, #FFFFFF 100%);
  border-bottom: 2rpx solid #FFE8DC;
}

.search-keyword-item:active {
  background: linear-gradient(90deg, #FFF0E6 0%, #FFF9F5 100%);
}

.suggestion-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.suggestion-icon.primary {
  opacity: 1;
  color: #FF6B00;
}

.suggestion-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.suggestion-text.primary {
  color: #FF6B00;
  font-weight: 500;
}

/* 无建议提示 */
.no-suggestions {
  padding: 32rpx 24rpx;
  text-align: center;
}

.no-suggestions-text {
  font-size: 24rpx;
  color: #999;
}

/* 搜索内容区域 */
.search-content {
  padding: 24rpx;
}

/* 搜索区块 */
.search-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.clear-btn {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  background-color: #f5f5f5;
}

.clear-btn .icon {
  margin-right: 4rpx;
}

.hot-badge {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8F3C 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  transition: all 0.3s;
}

.tag-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.tag-text {
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 历史标签 */
.history-tag {
  background-color: #f5f5f5;
  color: #666;
  border: 1rpx solid #eee;
}

.history-tag:active {
  background-color: #e8e8e8;
}

/* 热门标签 */
.hot-tag {
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8DC 100%);
  color: #FF6B00;
  border: 1rpx solid #FFD4B8;
}

.hot-tag:active {
  background: linear-gradient(135deg, #FFE8DC 0%, #FFD4B8 100%);
}

/* 搜索结果 */
.search-results {
  padding-bottom: 40rpx;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.sort-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.sort-item.active {
  color: #FF6B00;
  font-weight: bold;
}

.sort-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #FF6B00 0%, #FF8F3C 100%);
  border-radius: 2rpx;
}

.sort-label {
  display: inline-block;
}

/* 商品列表 */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.product-item {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s;
}

.product-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #FF6B00;
  font-weight: bold;
  margin-right: 2rpx;
}

.product-price {
  font-size: 36rpx;
  color: #FF6B00;
  font-weight: bold;
  line-height: 1;
}

.product-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

.product-rating {
  font-size: 22rpx;
  color: #FF8F3C;
}

/* 空状态 */
.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
}
