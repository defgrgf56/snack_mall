<!--pages/refund-apply/refund-apply.wxml-->
<view class="refund-apply-page">
  <!-- 订单信息 -->
  <view class="order-info" wx:if="{{order}}">
    <view class="order-header">
      <text class="order-no">订单号: {{order.order_no}}</text>
      <text class="order-amount">¥{{order.pay_amount}}</text>
    </view>
    <view class="product-list">
      <view class="product-item" wx:for="{{order.items}}" wx:key="id">
        <image class="product-image" src="{{item.product_cover}}" mode="aspectFill"></image>
        <view class="product-info">
          <text class="product-name">{{item.product_name}}</text>
          <view class="product-bottom">
            <text class="product-price">¥{{item.price}}</text>
            <text class="product-quantity">x{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 退款类型 -->
  <view class="form-section">
    <view class="section-title">退款类型</view>
    <view class="radio-group">
      <view class="radio-item" bindtap="selectType" data-type="1">
        <view class="radio {{refundType === 1 ? 'checked' : ''}}">
          <view class="radio-inner"></view>
        </view>
        <view class="radio-label">
          <text class="label-title">仅退款</text>
          <text class="label-desc">未收到货，或与卖家协商同意不退货只退款</text>
        </view>
      </view>
      <view class="radio-item" bindtap="selectType" data-type="2">
        <view class="radio {{refundType === 2 ? 'checked' : ''}}">
          <view class="radio-inner"></view>
        </view>
        <view class="radio-label">
          <text class="label-title">退货退款</text>
          <text class="label-desc">已收到货，需要退还商品</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 退款原因 -->
  <view class="form-section">
    <view class="section-title">退款原因 <text class="required">*</text></view>
    <picker mode="selector" range="{{reasonList}}" value="{{reasonIndex}}" bindchange="onReasonChange">
      <view class="picker">
        <text class="{{reasonIndex >= 0 ? '' : 'placeholder'}}">
          {{reasonIndex >= 0 ? reasonList[reasonIndex] : '请选择退款原因'}}
        </text>
        <text class="arrow">›</text>
      </view>
    </picker>
  </view>

  <!-- 退款金额 -->
  <view class="form-section">
    <view class="section-title">退款金额</view>
    <view class="amount-display">
      <text class="amount-label">¥</text>
      <text class="amount-value">{{order.pay_amount}}</text>
    </view>
  </view>

  <!-- 退款说明 -->
  <view class="form-section">
    <view class="section-title">退款说明(选填)</view>
    <textarea 
      class="textarea" 
      placeholder="请详细描述退款原因，有助于更快处理" 
      maxlength="200"
      value="{{refundDesc}}"
      bindinput="onDescInput"
    ></textarea>
    <view class="textarea-count">{{refundDesc.length}}/200</view>
  </view>

  <!-- 上传凭证 -->
  <view class="form-section">
    <view class="section-title">上传凭证(选填)</view>
    <view class="upload-container">
      <view class="image-list">
        <block wx:for="{{refundImages}}" wx:key="index">
          <view class="image-item">
            <image class="image" src="{{item}}" mode="aspectFill"></image>
            <view class="image-delete" bindtap="deleteImage" data-index="{{index}}">
              <text class="delete-icon">×</text>
            </view>
          </view>
        </block>
        <view class="upload-btn" wx:if="{{refundImages.length < 3}}" bindtap="chooseImage">
          <text class="upload-icon">+</text>
          <text class="upload-text">上传图片</text>
        </view>
      </view>
      <view class="upload-tip">最多上传3张图片，支持JPG、PNG格式</view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="submitRefund" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交申请'}}
    </button>
  </view>
</view>
