/* pages/refund-detail/refund-detail.wxss */
.refund-detail-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 状态区域 */
.status-section {
  background: linear-gradient(135deg, #ff6b00 0%, #ff8533 100%);
  padding: 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: #fff;
}

.status-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.status-icon.status-0 .icon::before { content: '⏳'; }
.status-icon.status-1 .icon::before { content: '✓'; }
.status-icon.status-2 .icon::before { content: '✕'; }
.status-icon.status-3 .icon::before { content: '💰'; }
.status-icon.status-4 .icon::before { content: '✓'; }
.status-icon.status-5 .icon::before { content: '✕'; }

.status-text {
  font-size: 36rpx;
  font-weight: bold;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.reject-reason {
  margin-top: 20rpx;
  padding: 24rpx;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.reason-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.reason-text {
  font-size: 28rpx;
  margin-left: 12rpx;
}

/* 信息区域 */
.info-section,
.order-section,
.progress-section {
  background-color: #fff;
  margin: 20rpx 0;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.info-item .label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
  width: 160rpx;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.info-item .value.amount {
  color: #ff6b00;
  font-weight: bold;
  font-size: 32rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: flex-end;
}

.image-list .image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

/* 订单信息 */
.order-no {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-item {
  display: flex;
  gap: 20rpx;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 28rpx;
  color: #ff6b00;
  font-weight: bold;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
}

/* 时间轴 */
.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background-color: #eee;
}

.timeline-item {
  position: relative;
  padding-bottom: 40rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item:last-child::after {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: -40rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: #ff6b00;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #ff6b00;
}

.timeline-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.timeline-status {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.timeline-remark {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
}

.timeline-operator {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮 */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
}

.cancel-btn {
  background-color: #fff;
  color: #ff6b00;
  border: 2rpx solid #ff6b00;
}
