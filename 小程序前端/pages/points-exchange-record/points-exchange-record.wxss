/* pages/points-exchange-record/points-exchange-record.wxss */
page {
  background-color: #f5f5f5;
}

.exchange-record {
  padding: 20rpx;
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 记录头部 */
.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-date {
  font-size: 26rpx;
  color: #999;
}

.record-status {
  font-size: 26rpx;
  font-weight: 500;
}

/* 记录内容 */
.record-content {
  display: flex;
  gap: 20rpx;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity {
  font-size: 26rpx;
  color: #999;
}

.points {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 记录底部 */
.record-footer {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.express-info {
  font-size: 24rpx;
  color: #666;
}

.express-info .label {
  color: #999;
  margin-right: 8rpx;
}

.express-info .value {
  color: #333;
}

/* 加载状态 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  display: block;
  margin-bottom: 40rpx;
}

.btn-goto-mall {
  display: inline-block;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C3A 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
}
