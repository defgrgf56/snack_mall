/* pages/order-confirm/order-confirm.wxss */
.order-confirm-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.order-content {
  height: calc(100vh - 200rpx);
}

/* 收货地址 */
.address-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-info {
  flex: 1;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.consignee {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.no-address {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 20rpx;
}

.arrow-text {
  font-size: 40rpx;
  color: #999;
  margin-left: 20rpx;
  line-height: 1;
}

/* 商品列表 */
.product-section {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.product-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: bold;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
}

/* 配送方式 */
.delivery-section {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.delivery-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #333;
}

.delivery-item radio {
  margin-right: 20rpx;
}

/* 订单备注 */
.remark-section {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.remark-input {
  min-height: 150rpx;
  font-size: 28rpx;
  color: #333;
  margin-top: 20rpx;
}

/* 优惠信息 */
.coupon-section {
  background-color: #fff;
  margin-bottom: 20rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
}

.coupon-label {
  font-size: 28rpx;
  color: #333;
}

.coupon-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.coupon-value .placeholder {
  color: #999;
}

.coupon-value .arrow-icon {
  margin-left: 10rpx;
}

/* 底部结算 */
.order-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
}

.price-info {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.price-item:last-child {
  margin-bottom: 0;
}

.price-item.total {
  font-size: 32rpx;
  font-weight: bold;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.price-label {
  color: #666;
}

.price-value {
  color: #333;
}

.price-value.discount {
  color: #ff6b35;
}

.price-value.final {
  color: #ff6b35;
  font-size: 36rpx;
}

.submit-btn {
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  border-radius: 0;
}
